# std/text.kiru
#
# Text helpers written on top of the native text kernel.

module std::text;

# Whether `text` contains `needle`. A needle that is present has a byte index
# and an absent one reads empty, so `find` answers this directly.
fn contains(txt text, txt needle) -> txt {
  switch(find(text, needle)) {
    case("") { return("false"); };
    default { return("true"); };
  };
};

# Whether `text` starts with `prefix`. A prefix that is present has a byte
# index at zero, so `find` answers this directly.
fn starts_with(txt text, txt prefix) -> txt {
  switch(find(text, prefix)) {
    case("0") { return("true"); };
    default { return("false"); };
  };
};

# Join a list of parts into one text with `separator` between each pair.
fn join(list parts, txt separator) -> txt {
  mut txt result = "";
  mut txt first = "true";
  for part in parts {
    switch(first) {
      case("true") { result = part; first = "false"; };
      default { result = result + separator + part; };
    };
  };
  return(result);
};

# Whether `text` ends with `suffix`. Splitting on `suffix` leaves a final empty
# piece exactly when the suffix matches at the end. An empty text is checked
# first, because only the empty suffix ends it.
fn ends_with(txt text, txt suffix) -> txt {
  switch(text) {
    case("") {
      switch(suffix) {
        case("") { return("true"); };
        default { return("false"); };
      };
    };
    default {};
  };
  mut txt last = "";
  for part in split(text, suffix) {
    last = part;
  };
  switch(last) {
    case("") { return("true"); };
    default { return("false"); };
  };
};

# Replace every occurrence of `from` with `to`. Splitting on `from` and joining
# with `to` is exactly that, including an empty `from`.
fn replace(txt text, txt from, txt to) -> txt {
  return(join(split(text, from), to));
};
