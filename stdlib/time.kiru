# std/time.kiru
#
# The time helper written on top of the native time kernel.

mod std::time {

  use std;

  # Sleep for `seconds` whole seconds. A negative count stops the run.
  pub fn sleep(seconds: int) {
    match seconds < 0 {
      true => { std::fail("`@(seconds)` is not a whole number of seconds"); };
      false => {};
    };
    std::time::sleep_seconds(seconds);
  };

};
