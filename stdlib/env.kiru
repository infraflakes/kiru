# std/env.kiru
#
# Environment helpers written on top of the native environment kernel.

module std::env;

# The directory temporary files belong in: `TMPDIR` when it is set, else
# `/tmp`, matching the platform's convention.
fn temp_dir() -> txt {
  txt directory = var("TMPDIR");
  switch(directory) {
    case("") { return("/tmp"); };
    default { return(directory); };
  };
};
