# std/io.kiru
#
# The line writers, built on the native I/O kernel.

module std::io;

# Write a line to stdout.
fn print(txt message) {
  write("1", message + "\n");
};

# Write a prefix and a message, coloring the prefix on a terminal. `color` is
# an ANSI SGR code and `file_descriptor` is "1" for stdout or "2" for stderr.

fn emit(txt color, txt prefix, txt file_descriptor, txt message) {
  switch(is_terminal(file_descriptor)) {
    case("true") {
      write(file_descriptor, "\e[" + color + "m" + prefix + "\e[0m " + message + "\n");
    };
    default {
      write(file_descriptor, prefix + " " + message + "\n");
    };
  };
};

# Write an "INFO:" line to stdout, yellow on a terminal.
fn log(txt message) {
  emit("33", "INFO:", "1", message);
};

# Write an "ERROR:" line to stderr, red on a terminal, then stop the run.
fn eprint(txt message) {
  emit("31", "ERROR:", "2", message);
  panic;
};
