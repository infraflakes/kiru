# std/path.kiru
#
# Path helpers written on top of the native path kernel and the text kernel.

mod std::path {

  # Whether a path is absolute.
  fn is_absolute(path<txt>) -> txt {
    return std::text::starts_with(path, "/");
  };

  # Join two path segments. An absolute `name` replaces `base`; an empty `base`
  # is replaced by `name`; and a `base` already ending in `/` is used as is.
  fn join(base<txt>, name<txt>) -> txt {
    return match is_absolute(name) {
      "true" => name;
      _ => match base {
        "" => name;
        _ => match std::text::ends_with(base, "/") {
          "true" => "@(base)@(name)";
          _ => "@(base)/@(name)";
        };
      };
    };
  };

  # The last segment of a path. An empty path has no segment, so it stops the
  # run.
  fn base(path<txt>) -> txt {
    return std::last(std::split(path, "/"));
  };

  # The path without its last segment.
  fn dir(path<txt>) -> txt {
    let mut head<list> = [];
    let mut pending<txt> = "";
    let mut first<txt> = "true";
    for part in std::split(path, "/") {
      match first {
        "true" => { first = "false"; };
        _ => { head = std::append(head, pending); };
      };
      pending = part;
    };
    return std::join(head, "/");
  };

  # The extension of a path, without the dot. A path whose last segment has no
  # dot has no extension.
  fn ext(path<txt>) -> txt {
    let name<txt> = base(path);
    match std::text::find(name, ".") {
      "" => { return ""; };
      _ => { return std::last(std::split(name, ".")); };
    };
  };

};