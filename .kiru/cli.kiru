mod kiru {

  use std::text;

  let usage_kiru: txt = "usage: kiru <flag>

flags:
  check      run the checks
  build      build the binary
  container  docker or podman build into bin
  format     apply clippy and rustfmt fixes
  update     cargo update and cargo upgrade";

  let usage_docs: txt = "usage: docs <flag>

flags:
  build   build the site
  check   check the site
  format  apply biome fixes
  update  bun update and biome migrate
  serve   preview the site";

  let usage_all: txt = "usage: all <flag>

flags:
  build   build both docs and backend
  check   check both docs and backend
  format  format both docs and backend
  update  update both docs and backend
  ci      check and build both";

  pub let usage: txt = "@(usage_kiru)\n\n@(usage_docs)\n\n@(usage_all)";

  fn container_cmd() -> txt {
    match std::command("command -v docker").stream("stdout", "/dev/null").stream("stderr", "/dev/null").run() {
      0 => {
        return "docker";
      };
      _ => {
        match std::command("command -v podman").stream("stdout", "/dev/null").stream("stderr", "/dev/null").run() {
          0 => {
            return "podman";
          };
          _ => {
            std::fail("No container binary found.");
          };
        };
      };
    };
  };

  pub fn kiru_command(project: Project, flag: txt) {
    match flag {
      "check" => { check_kiru(project); };
      "build" => { build_kiru(project); };
      "container" => {
        run(project, "@(container_cmd()) build --output type=local,dest=bin .");
      };
      "format" => { format_kiru(project); };
      "update" => { update_kiru(project); };
      _ => { std::fail(usage_kiru); };
    };
  };

  pub fn docs_command(docs: Project, flag: txt) {
    match flag {
      "build" => { build_docs(docs); };
      "check" => { check_docs(docs); };
      "format" => { format_docs(docs); };
      "update" => { update_docs(docs); };
      "serve" => {
        run(docs, "bun run preview");
      };
      _ => { std::fail(usage_docs); };
    };
  };

  pub fn all_command(kiru: Project, docs: Project, flag: txt) {
    match flag {
      "build" => {
        std::info("Building site");
        async build_docs(docs);
        std::info("Building backend");
        async build_kiru(kiru);
        wait;
        std::info("Both site and backend built successfully");
      };
      "update" => {
        run(kiru, "nix flake update");
        std::info("Updating backend");
        async update_kiru(kiru);
        std::info("Updating site");
        async update_docs(docs);
        wait;
        std::info("Updated dependencies");
      };
      "format" => {
        std::info("Formatting site");
        async format_docs(docs);
        std::info("Formatting backend");
        async format_kiru(kiru);
        wait;
        std::info("Backend and site formatted successfully!");
      };
      "check" => {
        std::info("Starting backend checks");
        async check_kiru(kiru);
        std::info("Starting site checks");
        async check_docs(docs);
        wait;
        std::info("Parallel checks finished");
      };
      "ci" => {
        std::info("Starting backend checks");
        async check_kiru(kiru);
        std::info("Starting site checks");
        async check_docs(docs);
        wait;
        std::info("Site and backend check completed");
        std::info("Building backend");
        async build_kiru(kiru);
        std::info("Building site");
        async build_docs(docs);
        wait;
        std::info("CI finished");
      };
      _ => { std::fail(usage_all); };
    };
  };
};
