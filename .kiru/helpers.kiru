mod kiru {

  # Wrap a line in `nix develop` when the project asks for it.
  fn wrap(project<rec>, line<txt>) -> txt {
    return match project.Nix {
      "true" => "nix develop -c sh -c @(std::quote(line))";
      _ => line;
    };
  };

  # Sequential step: stream the command's output; a non-zero exit stops the run.
  fn run(project<rec>, line<txt>) {
    std::log("Running '@(line)'");
    let code<txt> = std::command({ Dir = project.Dir }, wrap(project, line));
    match code {
      "0" => { std::log("'@(line)' ran successfully"); };
      _ => { std::eprint("'@(line)' failed"); };
    };
  };

  # Orchestrated step: hide stdout, keep stderr for debugging, return the code.
  fn status(project<rec>, line<txt>) -> txt {
    return std::command({ Dir = project.Dir, Stdout = "null" }, wrap(project, line));
  };
};
