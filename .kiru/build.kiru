pr kiru {

  fn build {
    log `Building kiru cli!`;
    exec `cargo build --release`;
  }

  fn build_with_container {
    var shell docker_bin = `command -v docker >/dev/null 2>&1 && echo "docker" || { command -v podman >/dev/null 2>&1 && echo "podman"; }`;
    case $kiru::docker_bin {
      `` {
        log `no container runtime found`;
        exec `exit 1`;
     };
      _  {
        log `building kiru with ${kiru::docker_bin}`;
        exec `${kiru::docker_bin} build --output type=local,dest=bin .`;
      };
    };
  }

}
