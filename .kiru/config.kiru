var shell kiru_dir = `echo $HOME/kiru`;

pr kiru [
  url = `https://github.com/infraflakes/kiru.git`
  dir = $kiru_dir
  sync = `clone`
  branch = `dev`
] {}

import `${kiru_dir}/.kiru/main.kiru`;

pr todo [
  url = `https://github.com/null/err.git`
  dir = `whatever`
] {
  fn build {}
  fn test {}
  run ci {
    build => test;
  }
}
