mod kiru {

  fn build_docs(docs<rec>) {
    run(docs, "bun install --frozen-lockfile");
    run(docs, "bun run build");
  };

  fn check_docs(docs<rec>) {
    run(docs, "bun run check");
    run(docs, "bun run types");
  };

  fn format_docs(docs<rec>) {
    run(docs, "bun run fix");
  };

  fn update_docs(docs<rec>) {
    run(docs, "bun update");
    run(docs, "biome migrate");
  };
};
