import "entry.kiru";

# `Project` is declared in the `kiru` namespace alongside the build scripts.
use kiru;

# The built-in type categories this file's signatures write bare.
use std;
use std::cli;
use std::text;
use std::vec;

let kiru: Project = {
  name = "kiru",
  Dir = ".",
  Nix = true,
};

let docs: Project = {
  name = "docs",
  Dir = "docs",
  Nix = true,
};

# The words after the subcommand, the first being the flag the shell runs.
fn flag_of(context: std::cli::Context) -> txt {
  let words: Vec<txt> = context.args();
  let flag: txt = match words.len() { 0 => ""; _ => words[0]; };
  return flag;
};

fn run_kiru(context: std::cli::Context) -> int {
  kiru::kiru_command(kiru, flag_of(context));
  return 0;
};

fn run_docs(context: std::cli::Context) -> int {
  kiru::docs_command(docs, flag_of(context));
  return 0;
};

fn run_all(context: std::cli::Context) -> int {
  kiru::all_command(kiru, docs, flag_of(context));
  return 0;
};

fn run_usage(context: std::cli::Context) -> int {
  std::eprint(kiru::usage);
  return 1;
};

fn main(words: Vec<txt>) -> int {
  let root: std::cli::Subcommand = std::cli::command("kiru").about("build the project")
    .action(run_usage);
  root = root.with(std::cli::command("kiru").about("build kiru").action(run_kiru));
  root = root.with(std::cli::command("docs").about("build the docs").action(run_docs));
  root = root.with(std::cli::command("all").about("build everything").action(run_all));
  return root.parse(words);
};
