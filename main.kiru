fn build_kiru {
  project(kiru) {
    log(Building kiru cli!);
    exec(cargo build --release);
  };
};

run build_kiru {
  build_kiru();
};

fn nix_kiru {
  project(kiru) {
    log(Building kiru with nix...);
    exec(nix build .#default);
  };
};

run nix_kiru {
  nix_kiru();
};

run clean_kiru {
  project(kiru) {
    log(Cleaning up artifacts...);
    exec(rm -rf bin);
    exec(rm -rf result);
  };
};

fn test_kiru {
  project(kiru) {
    log(Testing the codebase!);
    exec(cargo test);
    exec(cargo clippy -- -D warnings);
    exec(cargo fmt --check);
  };
};

run update_kiru {
  project(kiru) {
    log(Updating dependencies);
    exec(cargo update);
    exec(cargo upgrade);
    exec(nix flake update);
  };
};

run fail_kiru {
  log(Failing the task!);
  env(CGO_ENABLED = (0); GOOS = (linux);) {
    exec(go build ./...);
  };
};

run build_container_kiru {
  var docker_bin = $(command -v docker >/dev/null 2>&1 && echo "docker" || { command -v podman >/dev/null 2>&1 && echo "podman"; });
  project(kiru) {
    switch(@(docker_bin)) {
      case() {
        log(no container runtime found);
        exec(exit 1);
      };
      default {
        log(building kiru with @(docker_bin));
        exec(@(docker_bin) build --output type=local,dest=bin .);
      };
    };
  };
};

run test_kiru {
  project(kiru) {
    log(Formatting the codebase...);
    exec(cargo clippy --fix --allow-dirty);
    exec(cargo fmt);
  };
  test_kiru();
};

run ci_kiru {
  async() { test_kiru(); };
  async() { build_kiru(); };
};
