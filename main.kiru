import "entry.kiru";

rec kiru = {
  name = "kiru",
  Dir = ".",
  Nix = "true",
};

rec docs = {
  name = "docs",
  Dir = "docs",
  Nix = "true"
};

fn main(rec args) {
  switch(args.cmd) {
    case("kiru") { kiru::kiru_command(kiru, args.flag); };
    case("docs") { kiru::docs_command(docs, args.flag); };
    case("all") { kiru::all_command(kiru, docs, args.flag); };
    default { std::io::eprint(kiru::usage); };
  };
};
