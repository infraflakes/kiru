import "entry.kiru";

let kiru<rec> = {
  name = "kiru",
  Dir = ".",
  Nix = "true",
};

let docs<rec> = {
  name = "docs",
  Dir = "docs",
  Nix = "true"
};

fn main(args<rec>) {
  match args.cmd {
    "kiru" => { kiru::kiru_command(kiru, args.flag); };
    "docs" => { kiru::docs_command(docs, args.flag); };
    "all" => { kiru::all_command(kiru, docs, args.flag); };
    _ => { std::eprint(kiru::usage); };
  };
};
