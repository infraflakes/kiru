# kiru Language Reference (schema.kiru)
#
# kiru is a local project orchestrator CLI.
# This file documents every language feature with examples.
#
# Design principles:
#   - Every syntax error fails at parse time, never at runtime.
#   - All values use backtick delimiters: `...`
#   - No escape sequences — what you type is what you get.
#   - Variable interpolation inside backticks uses ${name} syntax.
#   - All primitives are block-scoped with no leakage.
#   - Global vars are accessible everywhere (including inside pr blocks).
#   - Project-scoped vars are isolated to their project.
#   - No cross-project execution — each project is self-contained.
#
# CLI usage:
#   kiru sync                      Clone/sync all project repositories
#   kiru run <name> <project>      Run a run block in a project (interactive TUI)
#   kiru fn <name> <project>       Run a function directly in a project
#   kiru validate                  Validate the configuration file
#   kiru version                   Print version
#   kiru -c <path> <command>       Use a custom config file
#
# Config discovery:
#   By default kiru looks for ~/.config/kiru/main.kiru.
#   Use -c or --config to override.

# 1. VARIABLE DECLARATIONS (global scope)
#
# Syntax: var <type> <name> = <value>;
#
# Types:
#   string  — stores the backtick content as-is
#   shell   — executes the backtick content via the user's shell ($SHELL),
#             stores the stdout (trailing newline stripped)
#
# Global variables are resolved in declaration order.
# Global vars ARE accessible from inside pr blocks (function bodies,
# project vars, and project fields).

var shell workdir = `echo $HOME/dev`;
var string port = `127.0.0.1:8080`;
var string greeting = `hello world`;

# Reference a previously declared variable with $name:
var string port_copy = $port;

# 2. SANCTUARY (required)
#
# The root directory where all project repositories live.
# Must be an absolute path.
#
# Accepts either a backtick literal or a $variable reference.

sanctuary = $workdir;

# 3. IMPORTS (optional)
#
# Import other .kiru files to split config across multiple files.
# Paths are resolved relative to the current file's directory
# (no ./ prefix required — `others.kiru` and `./others.kiru` are equivalent).
# Circular imports are detected and rejected at parse time.

import `others.kiru`;

# 4. PROJECT DECLARATIONS
#
# Syntax: pr <name> { ... }
#
# Declares a git repository to be managed by `kiru sync`.
# Projects are cloned into <sanctuary>/<dir>.
#
# Fields:
#   url    (required)  Git clone URL
#   dir    (required)  Directory name relative to sanctuary (must be unique)
#   sync   (optional)  `clone` (default) or `ignore`
#   include (optional)  Path to a .kiru file inside the project repo
#   branch (optional)  Branch to clone
#
# Inside a project block you can also declare:
#   var <type> <name> = <value>;   Project-scoped variables
#   fn <name> { ... }              Function declarations
#   run <name> { ... }             Orchestration block with chain syntax
#
# Project vars are accessible only within this project's functions.
# Global vars (top-level declarations) ARE accessible here.

pr todo {
    url = `git@github.com:yourname/todo.git`;
    dir = `todo`;
    sync = `clone`;

    var shell version = `git describe --tags --always --dirty 2>/dev/null || echo dev`;
    var string app = `todo`;

    # Global vars like $port and $greeting are also accessible here

    fn build {
        log `Building ${app} at ${version}`;
        var shell os = `uname -s`;
        case $os {
            `Linux`  {
                cd `cmd`;
                exec `go build -ldflags='${version}' -o bin/${app} .`;
            };
            `Darwin` {
                cd `cmd`;
                exec `go build -ldflags='${version}' -o bin/${app} .`;
            };
            _        { log `unsupported OS: ${os}`; };
        };
    }

    fn test {
        env [CGO_ENABLED = `0`, GOOS = `linux`] {
            exec `go test -race ./...`;
            exec `go vet ./...`;
        };
    }

    fn lint {
        exec `golangci-lint run ./...`;
    }

    fn check {
        log `Running checks...`;
        exec `go fmt ./...`;
        exec `go vet ./...`;
    }

    # A run block with two chains, running concurrently:
    #   chain 1: lint => test => build (sequential within the chain)
    #   chain 2: check (single fn, runs concurrently with chain 1)
    run quality {
        lint => test => build;
        check;
    }

    run release {
        lint => test => build;
    }
}

pr calendar {
    url = `git@github.com:yourname/calendar.git`;
    dir = `calendar`;
    sync = `clone`;
    include = `.kiru/main.kiru`;
    branch = `rust`;

    # Include files can declare var/fn/run that get merged into this project.
    # Include file path is relative to the project directory.
}

# 5. FUNCTION PRIMITIVES
#
# Available inside fn { ... }:
#   log <expr>;            Print a message
#   exec <expr>;           Run a shell command via the user's shell ($SHELL)
#   cd <expr>;             Change cwd relative to current working dir (cumulative)
#   var <type> <n> = <v>;  Declare a scoped variable
#   env [...] { ... };     Scoped environment variable block
#   case <expr> { ... };   Conditional branching (first-match semantics)
#
# Variable interpolation:
#   Use ${name} inside backticks to interpolate variables.
#   Lookup order: fn-local vars → project vars → global vars.
#   All variable references are validated at load time.
#
# Variable scoping:
#   - var_stack[-1] (current fn/block body) → var_stack[-2] (case arm
#     or env block) → self.vars (global + project vars). Each layer
#     shadows the parent.
#   - fn calls are fully isolated: work_dir and var_stack are saved
#     and restored on entry/exit. Nothing leaks across calls.
#   - env blocks push/pop both an env layer and a var layer, so
#     declarations inside env are local to that block.
#
# cd semantics:
#   - Relative paths are resolved against the current working directory
#     (which starts at the project dir and changes cumulatively).
#   - Absolute paths are rejected.
#   - Cannot escape the project directory.
#
# Conditional branching with case:
#   - Condition is an expression (backtick or $var reference)
#   - Each arm has a pattern followed by a body in braces
#   - Patterns: `literal`, $var_ref, or _ (default/catch-all)
#   - Patterns support ${interpolation}: `hello ${world}`
#   - First matching arm wins, then execution continues after the case block
#   - Each arm body ends with ; (consistent with env blocks)
#   - The entire case block ends with ; (consistent with env blocks)
#
#   Example:
#     var shell docker_bin = `command -v docker 2>/dev/null || command -v podman 2>/dev/null`;
#     case $docker_bin {
#         ``      { log `no container runtime found`; };
#         _       { exec `${docker_bin} build .`; };
#     };

# 6. CI/CD MODE (SANCTUARY=0)
#
# When the SANCTUARY=0 environment variable is set, kiru operates in
# standalone mode without a sanctuary directory or project scope.
# This is useful for CI/CD pipelines that cannot set up a sanctuary.
#
# In this mode:
#   - Config is read from .kiru/main.kiru in the current directory
#     (instead of ~/.config/kiru/main.kiru)
#   - sanctuary declaration is not required
#   - pr blocks are not required
#   - Top-level fn and run declarations are used directly
#   - kiru fn <name> and kiru run <name> work without a project argument
#   - kiru sync is not available
#
# Example standalone config for CI/CD:
#
#   fn build {
#       exec `cargo build --release`;
#   }
#
#   fn test {
#       exec `cargo test`;
#   }
#
#   run all {
#       build => test;
#   }
#
# Usage: SANCTUARY=0 kiru run all
#        SANCTUARY=0 kiru fn build

# 7. INCLUDE FILES
#
# If a project declares `include`, that file is parsed after `kiru sync`.
# Include files use the same grammar as any .kiru file.
# They can declare var, fn, and run blocks that get merged into the
# project's scope — allowing shared declarations across multiple projects.
#
# Include files cannot declare sanctuary, pr, or import.

