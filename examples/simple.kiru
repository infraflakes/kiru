shell = `bash`;
var shell workdir = `echo $HOME/dev`;
sanctuary = $workdir;

pr kiru {
    url = `git@github.com:infraflakes/kiru.git`;
    dir = `kiru`;
    sync = `ignore`;

    fn check {
        log `checking project...`;
        exec `echo done`;
    }

    fn build {
        log `building...`;
        exec `echo build complete`;
    }

    run all {
        check;
        build;
    }
}
