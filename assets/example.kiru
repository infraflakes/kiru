# The smallest useful kiru setup.
#
# Copy to ~/.config/kiru/main.kiru, add a "todo" project to kiru.toml,
# then: kiru compile -c kiru.toml -p default, kiru status -p default, kiru run ci -p default.
# Every declaration ends with a semicolon.

var app = (todo);

fn build {
  log(Building @(app)...);
  exec(go build -o bin/@(app) .);
};

fn test {
  log(Testing @(app)...);
  env(CGO_ENABLED = (0);) {
    exec(go test -race ./...);
  };
};

run ci {
  project(todo) {
    test();
    build();
  };
};
