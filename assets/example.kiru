# The smallest useful kiru setup.
#
# Copy to ~/.config/kiru/main.kiru, add a "todo" project to kiru.toml,
# then: kiru compile -p default, kiru status -p default, kiru run ci -p default.
# Every declaration ends with a semicolon.

var app = (todo);

fn build(app) {
  log(Building @(app)...);
  exec(printf 'built @(app)\n');
};

fn test(app) {
  log(Testing @(app)...);
  exec(printf 'tested @(app)\n');
};

run ci {
  project(todo) {
    test(@(app));
    build(@(app));
  };
};
