var string app    = `todo`;
var shell os      = `uname -s`;

pr todo [
  url  = `git@github.com:yourname/todo.git`
  dir  = `todo`
  sync = `clone`
] {
    var shell version = `git describe --tags --always --dirty 2>/dev/null || echo dev`;

    fn build {
        log `Building ${global::app} at ${todo::version}`;
        case $global::os {
            `Linux` {
                cd `cmd`;
                exec `go build -ldflags='${todo::version}' -o bin/${global::app} .`;
            };
            `Darwin` {
                cd `cmd`;
                exec `go build -ldflags='${todo::version}' -o bin/${global::app} .`;
            };
            _ { log `unsupported OS: ${global::os}`; };
        };
    }

    fn test {
        env [CGO_ENABLED = `0` GOPATH = `$HOME/go`] {
            exec `go test -race ./...`;
            exec `go vet ./...`;
        };
    }

    run ci {
        todo::test => todo::build;
    }
}
