var string app = `todo`;
var shell os   = `uname -s`;

fn build {
    log `Building ${global::app}...`;
    case $global::os {
        `Linux` {
            exec `go build -o bin/${global::app} .`;
        };
        `Darwin` {
            exec `go build -o bin/${global::app} .`;
        };
        _ { log `unsupported OS: ${global::os}`; };
    };
}

fn test {
    env [CGO_ENABLED = `0`] {
        exec `go test -race ./...`;
    };
}

pr todo [
    url  = `git@github.com:yourname/todo.git`
    dir  = `todo`
    sync = `clone`
] {
    var string version = `dev`;
    use build;
    use test;
}

run ci {
    todo::test => todo::build;
}
