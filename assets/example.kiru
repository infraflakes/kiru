# The smallest useful kiru setup.
#
# Copy to ~/.config/kiru/main.kiru, add a "todo" repo to kiru.toml,
# then: kiru compile -c main.kiru -o ~/.config/kiru, kiru status, kiru run ci.
# Every declaration ends with a semicolon.

var app = (todo);

pr todo {
  fn build {
    log (Building @(app)...);
    $(go build -o bin/@(app) .);
  };

  fn test {
    log (Testing @(app)...);
    env {
      CGO_ENABLED = (0);
    } {
      $(go test -race ./...);
    };
  };
};

run ci {
  todo::test => todo::build;
};
