(* ──────────────────────────────────────────────────────────────────── *)
(*  kiru DSL — EBNF Grammar                                          *)
(* ──────────────────────────────────────────────────────────────────── *)

(* ═══════════════════════════════════════════════════════════════════ *)
(*  PROGRAM                                                          *)
(* ═══════════════════════════════════════════════════════════════════ *)

program          = { statement } ;
statement        = import_decl | var_decl
                 | fn_decl | project_decl | run_decl ;

(* ═══════════════════════════════════════════════════════════════════ *)
(*  GLOBAL DECLARATIONS                                              *)
(* ═══════════════════════════════════════════════════════════════════ *)

import_decl      = "import" expr ";" ;
var_decl         = "var" type ident "=" expr ";" ;
type             = "string" | "shell" ;

(* ═══════════════════════════════════════════════════════════════════ *)
(*  FUNCTION (always top-level)                                      *)
(* ═══════════════════════════════════════════════════════════════════ *)

fn_decl          = "fn" ident "{" { fn_stmt } "}" ;
fn_stmt          = log_stmt | exec_stmt | cd_stmt
                 | var_decl | env_block | case_stmt ;

log_stmt         = "log"  expr ";" ;
exec_stmt        = "exec" expr ";" ;
cd_stmt          = "cd"   expr ";" ;

(* ── env block ──────────────────────────────────────────────────── *)

env_block        = "env" "[" [ env_pairs ] "]" "{" { fn_stmt } "}" ";" ;
env_pairs        = env_pair { env_pair } ;
env_pair         = ident "=" expr ;

(* ── case block ─────────────────────────────────────────────────── *)

case_stmt        = "case" expr "{" case_arm { case_arm } "}" ";" ;
case_arm         = case_pattern "{" { fn_stmt } "}" ";" ;
case_pattern     = backtick_expr          (* literal — exact string match *)
                 | var_ref                (* variable reference         *)
                 | "_" ;                  (* default / catch-all        *)

(* ═══════════════════════════════════════════════════════════════════ *)
(*  PROJECT — declares a repo + applies global functions             *)
(* ═══════════════════════════════════════════════════════════════════ *)

project_decl     = "pr" ident [ "[" field_decl { field_decl } "]" ] "{" { project_stmt } "}" ;
project_stmt     = var_decl | use_decl ;
field_decl       = ident "=" expr ;

(* Recognised field names: url, dir, sync, branch. Unknown fields are *)
(* rejected at parse time.                                            *)

use_decl         = "use" ident [ "as" ident ] ";" ;

(* ═══════════════════════════════════════════════════════════════════ *)
(*  RUN BLOCK — orchestrates functions across projects              *)
(* ═══════════════════════════════════════════════════════════════════ *)

run_decl         = "run" ident "{" chain { chain } "}" ;
chain            = qualified_fn_ref { "=>" qualified_fn_ref } ";" ;
qualified_fn_ref = ident "::" ident ;     (* project::function *)

(* ═══════════════════════════════════════════════════════════════════ *)
(*  EXPRESSIONS                                                      *)
(* ═══════════════════════════════════════════════════════════════════ *)

expr             = backtick_expr | var_ref ;

var_ref          = "$" ident "::" ident ;   (* $namespace::name *)

backtick_expr    = "`" { interpolation | raw_char } "`" ;
interpolation    = "${" ident "::" ident "}" ;  (* ${namespace::name} *)

(* ═══════════════════════════════════════════════════════════════════ *)
(*  LEXICAL TOKENS                                                   *)
(* ═══════════════════════════════════════════════════════════════════ *)

ident            = ( letter | "_" ) { letter | digit | "_" } ;
letter           = "A" | "B" | … | "Z" | "a" | "b" | … | "z" ;
digit            = "0" | "1" | … | "9" ;
raw_char         = ? any character except "`" or "\n" ? ;

(* Keywords (reserved, cannot be used as identifiers):               *)
(*   import var string shell pr fn run log exec cd env case use      *)
(*                                                                   *)
(* Comments start with # and run to end of line.                     *)
(* ──────────────────────────────────────────────────────────────────── *)
