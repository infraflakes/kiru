(* ----------------------------------------------------------------- *)
(*  kiru DSL - EBNF Grammar                                         *)
(* ----------------------------------------------------------------- *)

(* Whitespace between tokens is insignificant, with one exception:    *)
(* a statement keyword and its call parens must be adjacent           *)
(* (log(x), never log (x)). The adjacency is what the lexer fuses     *)
(* into one call-shaped token, so `word(...)` is always one unit.     *)
(* Argument lists are `;`-separated, with an optional trailing `;`.   *)

(* ================================================================= *)
(*  PROGRAM                                                          *)
(* ================================================================= *)

program          = { statement } ;
statement        = import_decl | var_decl | fn_decl | run_decl ;
(* Functions are global named bundles: callable from any body and
   importable across files. A run block is an entry point (main()),
   invoked from the command line.                                   *)

(* ================================================================= *)
(*  DECLARATIONS                                                     *)
(* ================================================================= *)

import_decl      = "import" "(" template ")" ";" ;
var_decl         = "var" ident "=" template ";" ;
fn_decl          = "fn" ident [ params ] "{" { fn_stmt } "}" ";" ;
params           = "(" [ ident { ";" ident } [ ";" ] ] ")" ;

(* ================================================================= *)
(*  FUNCTION BODIES                                                  *)
(* ================================================================= *)

fn_stmt          = log_stmt | exec_stmt | cd_stmt | var_decl
                 | env_block | switch_stmt | call_stmt | async_stmt
                 | project_block ;

log_stmt         = "log" "(" template ")" ";" ;
(* Run the resolved template as a shell command with live output; a
   non-zero exit aborts. The argument is raw text: every `;` is
   literal shell text, only @() and $() are special.                *)
exec_stmt        = "exec" "(" template ")" ";" ;
cd_stmt          = "cd" "(" template ")" ";" ;

(* A call to another function. Arguments are positional templates,
   bound to the callee's params at compile time. The call runs in the
   innermost enclosing project context, or at the invocation context. *)
call_stmt        = ident "(" [ argument { ";" argument } [ ";" ] ] ")" ";" ;

(* -- project block ------------------------------------------------- *)

(* Run the body in a project's context: its directory and direnv
   setting from kiru.toml, restored when the block ends. The name is
   a template: @() inlines at compile time, $() resolves at runtime. *) 
project_block    = "project" "(" template ")" "{" { fn_stmt } "}" ";" ;

(* -- async block --------------------------------------------------- *)

(* Start this body now and join it at the end of the enclosing body.
   It runs on a copy of the context, so changes never leak out.     *)
async_stmt       = "async" "(" ")" "{" { fn_stmt } "}" ";" ;

(* -- env block ---------------------------------------------------- *)

env_block        = "env" "(" [ env_pair { ";" env_pair } [ ";" ] ] ")"
                   "{" { fn_stmt } "}" ";" ;
env_pair         = ident "=" template ;

(* -- switch block ------------------------------------------------- *)

switch_stmt      = "switch" "(" template ")" "{" { switch_arm } "}" ";" ;
switch_arm       = case_arm | default_arm ;
case_arm         = "case" "(" template ")" "{" { fn_stmt } "}" ";" ;
(* Patterns match the resolved subject, so they must reduce to literal
   text: @(var) is allowed (inlined at compile time), $(cmd) is not. *)
default_arm      = "default" "{" { fn_stmt } "}" ";" ;

(* ================================================================= *)
(*  RUN BLOCKS - entry points                                        *)
(* ================================================================= *)

run_decl         = "run" ident "{" { fn_stmt } "}" ";" ;
(* A run body is a normal statement list, executed by `kiru run <name>`.
   `;` always means "then"; concurrency is the `async` primitive.    *)

(* ================================================================= *)
(*  TEMPLATES / EXPRESSIONS                                         *)
(* ================================================================= *)

argument         = template ;

(* a template is (text), @(name) to interpolate a variable, or       *)
(* $(command) to run one                                             *)

template         = "(" { template_part } ")"
                 | "$(" { template_part } ")"
                 | "@(" ident ")"
                 | ident ;

template_part    = lit_text
                 | "@(" ident ")"
                 | "$(" template ")" ;

lit_text         = ? any character except ")", "@(", "$( " ? ;

(* A bare `(` inside a template is literal text; only `@(` and `$( ` *)
(* start nested parts.                                              *)

(* ================================================================= *)
(*  LEXICAL TOKENS                                                   *)
(* ================================================================= *)

ident            = ( letter | "_" ) { letter | digit | "_" } ;
letter           = "A" | "B" | ... | "Z" | "a" | "b" | ... | "z" ;
digit            = "0" | "1" | ... | "9" ;

(* Keywords (reserved: they cannot be used as identifiers, variable
   names, parameters, or function names; this is what keeps foo()
   unambiguous against the built-in primitives):                    *)
(*   import var fn run project log exec cd env switch case default async *)
(*                                                                  *)
(* Comments start with # and run to end of line.                    *)
(* Every declaration ends with a semicolon: var, fn, run, import,   *)
(* and each statement inside every body.                            *)
(* ----------------------------------------------------------------- *)
