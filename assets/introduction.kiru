# kiru — introductory example
#
# This file demonstrates every DSL feature in a single project.
# Each section builds on the previous one.
#
# Usage:
#   kiru status                # check that this config is correct
#   kiru sync                  # clone the repository
#   kiru fn <name> <project>   # run a single function
#   kiru run <name> <project>  # run an orchestration plan (TUI)

# 1. GLOBAL VARIABLES
#
# var <string|shell> <name> = `<value>`;
#
#   string — stores the value as-is
#   shell  — executes the value as a shell command, captures stdout
#
# Variables are resolved in declaration order. A variable can reference
# any previously declared variable with $global::name or ${global::name}.

var string app    = `myapp`;
var string user   = `yourname`;
var string repo   = `${global::user}/${global::app}`;
var shell os      = `uname -s`;

# 2. IMPORT
#
# Split config across multiple .kiru files.
# Paths are relative to the current file's directory.
#
# import `common.kiru`;

# 3. PROJECT
#
# Syntax: pr <name> [field = value ...] { ... }
#
# Fields (space-separated inside brackets):
#   url     (required)  Git clone URL
#   dir     (required)  Directory for the project
#   sync    (optional)  `clone` (default) or `ignore`
#   branch  (optional)  Git branch to clone
#
# Inside the braces you declare:
#   var <type> <name> = <value>;   Project-scoped variables
#   fn <name> { ... }              Functions
#   run <name> { ... }             Run blocks with chain syntax

pr myapp [
  url  = `git@github.com:${global::user}/myapp.git`
  dir  = `${global::app}`
  sync = `clone`
  branch = `main`
] {
    # Project vars are accessible within this project's functions.
    var string docker_registry = `ghcr.io/${global::user}`;
    var string port = `3000`;

    # 4. FUNCTIONS
    #
    # Primitives available inside fn { ... }:
    #
    #   log <expr>;             Print a message
    #   exec <expr>;            Run a shell command
    #   cd <expr>;              Change working directory (cumulative, relative)
    #   var <type> <n> = <v>;   Block-scoped variable
    #   env [...] { ... };      Scoped environment variables
    #   case <expr> { ... };    Conditional branching

    fn check {
        log `Running static checks for ${global::app}...`;
        cd `.`;
        exec `go fmt ./...`;
        exec `go vet ./...`;
    }

    fn build {
        log `Building ${global::app} on ${global::os}...`;

        # Conditional branching with case.
        # Patterns:
        #   `literal`          — exact match (literal pattern)
        #   $namespace::name   — match against a variable's value
        #   ``                 — match empty string
        #   _                  — catch-all / default
        #
        # The first matching arm wins.

        case $global::os {
            `Linux` {
                env [GOOS = `linux` GOARCH = `amd64`] {
                    exec `go build -o bin/${global::app} .`;
                };
            };
            `Darwin` {
                cd `cmd`;
                exec `go build -o ../bin/${global::app} .`;
            };
            _ {
                log `unsupported OS: ${global::os}, falling back to native build`;
                exec `go build -o bin/${global::app} .`;
            };
        };
    }

    fn test {
        log `Running tests for ${global::app}...`;
        var shell gopath = `echo $HOME/.local/share/go`;

        # env block sets environment variables for its body.
        env [
          CGO_ENABLED = `0`
          GOPATH = $myapp::gopath
        ] {
            log `Testing go program`;
            exec `go test -race ./...`;
        };
    }

    fn lint {
        exec `golangci-lint run ./...`;
    }

    fn release {
        # Nested case with $namespace::name pattern.
        var shell tag = `git describe --tags --always 2>/dev/null`;
        case $myapp::tag {
            `` {
                log `no git tag found, skipping release`;
            };
            _ {
                log `releasing ${myapp::tag}...`;
                exec `docker build -t ${myapp::docker_registry}/${global::app}:${myapp::tag} .`;
                exec `docker push ${myapp::docker_registry}/${global::app}:${myapp::tag}`;
            };
        };
    }

    # 5. RUN BLOCKS
    #
    # A run block declares an orchestration plan using chains.
    #
    #   ;   separates concurrent chains (run in parallel)
    #   =>  sequences functions within a chain (run sequentially)
    #
    # Example: run all { myapp::lint => myapp::check => myapp::build; myapp::test; }
    #
    #   Chain 1: lint -> check -> build  (sequential)
    #   Chain 2: test                    (runs concurrently with chain 1)

    run all {
        myapp::lint => myapp::check => myapp::build;
        myapp::test;
    }

    run ci {
        myapp::lint => myapp::test;
    }
}

# 6. CI/CD MODE
#
# Set KIRU_CWD=1 to run fn / run commands in the current directory
# instead of the project's dir field:
#
#   KIRU_CWD=1 kiru fn build myapp
#
# Useful when you're already in the right directory (e.g. a CI job).
