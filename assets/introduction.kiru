# kiru - introduction
#
# This file walks through the language, feature by feature.
# Each section builds on the last; the file compiles as it stands.
# Every declaration ends with a semicolon.
#
# Try it after reading:
#   kiru compile -c kiru.toml -p default   # turn this into the compiled program
#   kiru status -p default                 # see what kiru found
#   kiru run all -p default                # run the pipeline at the bottom

# -- 1. VARIABLES -----------------------------------------------------
#
# A var holds a value you can reuse.
#
#   var name = (text);      the text as-is
#   var name = $(command);  run the command now and keep its output
#
# A failed $(command) is not an error; it leaves "". Handy for probing,
# e.g. var has_docker = $(command -v docker).
#
# Use @(name) later to use the value again.

var app  = (myapp);
var user = (yourname);
var os   = $(uname -s);

# @(app) works inside any template, so this builds a name out of parts:
var repo = (@(user)/@(app));

# -- 2. IMPORT --------------------------------------------------------
#
# Pull in another file with import. The path is a template and is
# relative to the importing file:
#
#   import(./shared.kiru);
#
# Variables already in scope work in the path too:
#
#   var dir = (~/configs);
#   import(@(dir)/common.kiru);
#
# Everything imported joins one global namespace, so function names must
# be unique across every imported file.

# -- 3. FUNCTIONS -----------------------------------------------------
#
# A function is a named bundle of steps: primitives and other function
# calls, run top-down. Every statement is a call; the keyword and its
# call parens must be adjacent (log(x), never log (x)), and whitespace
# between other tokens is free.
#
#   log(msg);             print a message
#   exec(cmd);            run a shell command (live output); the
#                         argument is raw text, so `;` is literal
#   cd(path);             change directory for the rest of the function
#   name(args);           call another function
#
#   var name = (val);     a value used by the rest of this body
#   var name = $(cmd);    same, but captured when you run kiru compile
#
#   env(KEY = (val);) {   run a block with extra environment
#       ...;
#   };
#
#   switch(@(x)) {        run the first case that matches
#       case(value) { ... };
#       default { ... };    everything else
#   };
#
# Functions take positional parameters, written after the name and
# separated by `;`:
#
#   fn greet(name) {
#     log(hello @(name));
#   };
#
# ... and calls pass positional arguments the same way: greet(world);
# Arguments are substituted for the parameters when the call is compiled
# (carbon-copy), so a function grows per call site, with no runtime scope.

fn check(name) {
  log(Running static checks for @(name)...);
  var dir = (@(name));
  cd(@(dir));
  exec(go fmt ./...);
  exec(go vet ./...);
};

fn build(name; target) {
  log(Building @(name) for @(target)...);

  switch(@(os)) {
    case(Linux) {
      env(GOOS = (linux); GOARCH = (amd64);) {
        exec(go build -o bin/@(name) .);
      };
    };
    case(Darwin) {
      cd(cmd);
      exec(go build -o ../bin/@(name) .);
    };
    default {
      log(unsupported OS: @(os), falling back to native build);
      exec(go build -o bin/@(name) .);
    };
  };
};

fn test(name) {
  log(Running tests for @(name)...);
  env(CGO_ENABLED = (0);) {
    exec(go test -race ./...);
  };
};

# -- 4. RUN BLOCKS ----------------------------------------------------
#
# A run block is the entry point, like main() in other languages: a body
# of statements exactly like a function body, executed by `kiru run <name>`.
#
#   project(app) { ... };     run the body in that project's context
#                             (directory and direnv from kiru.toml)
#   function(args);           run at the current context
#   ;                         the next statement runs after this one
#
# Concurrency is the `async` primitive: its body starts right away and is
# joined when the enclosing body ends. Inside it cd and env apply to a
# copy of the context, so they never leak out.
#
#   async() { ... };          start this body now, join at the end
#
# A run body's statements are the progress rows you see while it runs:
# a sequential call is its own row, an async block groups its steps.
# The first failure anywhere stops the run: running processes are killed
# and pending steps are cancelled.

run all {
  project(myapp) {
    async() {
      check(myapp);
      build(myapp; release);
    };
    async() {
      test(myapp);
    };
  };
};

run ci {
  project(myapp) {
    check(myapp);
    test(myapp);
  };
};

# -- 5. PROJECT CONTEXTS ----------------------------------------------
#
# kiru.toml is the source of truth for machine-specific things: the
# profile's compile paths, and the projects that give calls their working
# directory and direnv setting.
#
#   [profile.default]
#   source = "main.kiru"
#   output = "compiled"
#
#   [profile.default.project.myapp]
#   url    = "git@github.com:you/myapp.git"
#   dir    = "~/projects/myapp"
#   direnv = true
#
# `kiru sync` clones or updates those repositories. The DSL itself never
# touches the network or the filesystem layout.
