# kiru — introductory example
#
# This file demonstrates every DSL feature in a single project.
# Each section builds on the previous one.
#
# Usage:
#   kiru validate              # check that this config is correct
#   kiru sync                  # clone the repository
#   kiru fn <function name> <project's name>        # run a single function
#   kiru run <name> <project name>         # run an orchestration plan (TUI)

# 1. GLOBAL VARIABLES
#
# var <string|shell> <name> = `<value>`;
#
#   string — stores the value as-is
#   shell  — executes the value as a shell command, captures stdout
#
# Variables are resolved in declaration order. A variable can reference
# any previously declared variable with $name or ${name}.

var string app    = `myapp`;
var string user   = `yourname`;
var string repo   = `${user}/${app}`;
var shell os      = `uname -s`;
var shell workdir = `echo $HOME/dev`;

# 2. SANCTUARY
#
# The root directory where all project repositories are cloned.
# Must be an absolute path. Accepts a literal or $variable reference.

sanctuary = $workdir;

#  3. IMPORT
#
# Split config across multiple .kiru files.
# Paths are relative to the current file's directory.
#
# import `common.kiru`;

# 4. PROJECT
#
# Syntax: pr <name> { ... }
#
# Fields:
#   url     (required)  Git clone URL
#   dir     (required)  Directory inside sanctuary
#   sync    (optional)  `clone` (default) or `ignore`
#   branch  (optional)  Git branch to clone
#   include (optional)  .kiru file inside the project to merge in, included kiru files cant use pr fields in favor for [standalone mode](#standalone-mode)
#
# Inside a pr block you can also declare:
#   var <type> <name> = <value>;   Project-scoped variables
#   fn <name> { ... }              Functions
#   run <name> { ... }             Run blocks with chain syntax

pr myapp {
    url  = `git@github.com:${user}/myapp.git`;
    dir  = `${app}`;
    sync = `clone`;
    branch = `main`;
    include = `.kiru/main.kiru`;

    # Project vars are accessible within this project's functions.
    var string docker_registry = `ghcr.io/${user}`;
    var string port = `3000`;

    # 5. FUNCTIONS
    #
    # Primitives available inside fn { ... }:
    #
    #   log <expr>;             Print a message
    #   exec <expr>;            Run a shell command
    #   cd <expr>;              Change working directory (cumulative, relative)
    #   var <type> <n> = <v>;   Block-scoped variable
    #   env [...] { ... };      Scoped environment variables
    #   case <expr> { ... };    Conditional branching

    fn check {
        log `Running static checks for ${app}...`;
        cd `.`;
        exec `go fmt ./...`;
        exec `go vet ./...`;
    }

    fn build {
        log `Building ${app} on ${os}...`;

        # Conditional branching with case.
        # Patterns:
        #   `literal`     — exact match (literal pattern)
        #   $var_ref      — match against a variable's value
        #   ``            — match empty string
        #   _             — catch-all / default
        #
        # The first matching arm wins.

        case $os {
            `Linux` {
                env [GOOS = `linux`, GOARCH = `amd64`] {
                    exec `go build -o bin/${app} .`;
                };
            };
            `Darwin` {
                cd `cmd`;
                exec `go build -o ../bin/${app} .`;
            };
            _ {
                log `unsupported OS: ${os}, falling back to native build`;
                exec `go build -o bin/${app} .`;
            };
        };
    }

    fn test {
        log `Running tests for ${app}...`;
        var shell gopath = `echo $HOME/.local/share/go`;

        # env block sets environment variables for its body.
        env [
          CGO_ENABLED = `0`,
          GOPATH = $gopath, # trailing is allowed
        ] {
            log `Testing go program`;
            exec `go test -race ./...`;
        };
    }

    fn lint {
        exec `golangci-lint run ./...`;
    }

    fn release {
        # Nested case with $var_ref pattern.
        var shell tag = `git describe --tags --always 2>/dev/null`;
        case $tag {
            `` {
                log `no git tag found, skipping release`;
            };
            _ {
                log `releasing ${tag}...`;
                exec `docker build -t ${docker_registry}/${app}:${tag} .`;
                exec `docker push ${docker_registry}/${app}:${tag}`;
            };
        };
    }

    # 6. RUN BLOCKS
    #
    # A run block declares an orchestration plan using chains.
    #
    #   ;   separates concurrent chains (run in parallel)
    #   =>  sequences functions within a chain (run sequentially)
    #
    # Example: run all { lint => check => build; test; }
    #
    #   Chain 1: lint → check → build  (sequential)
    #   Chain 2: test                  (runs concurrently with chain 1)

    run all {
        lint => check => build;
        test;
    }

    run ci {
        lint => test;
    }
}

# 7. STANDALONE MODE
#
# Set the environment variable SANCTUARY=0 to run without a sanctuary directory.
# Useful for CI/CD pipelines. In this mode:
#   - sanctuary and project blocks are not required
#   - Top-level functions and run blocks are used directly
#   - Config is read from .kiru/main.kiru in the current directory
#   - kiru sync is not available
#
# Example:
#   # SANCTUARY=0 kiru validate
#   # SANCTUARY=0 kiru fn build
#   # SANCTUARY=0 kiru run ci
