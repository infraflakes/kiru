# kiru — introductory example
#
# This file walks through every DSL feature step by step.
#
# Usage:
#   kiru status                 # check the config is valid
#   kiru sync                   # clone all repos
#   kiru fn  build  myapp       # run a single function
#   kiru run all                # run an orchestration pipeline

# ── 1. GLOBAL VARIABLES ─────────────────────────────────────────────
#
# var string name = `value`;     store value as-is
# var shell  name = `command`;   run command now, store its output
#
# Global var shell runs in the current directory at config-check time.
# A failed command returns "" (not an error) — useful for probing.
#
# Use $global::name or ${global::name} to reference a global variable.

var string app  = `myapp`;
var string user = `yourname`;
var string repo = `${global::user}/${global::app}`;
var shell os    = `uname -s`;

# ── 2. IMPORT ──────────────────────────────────────────────────────
#
# Split config across multiple .kiru files.
# Paths are relative to the current file's directory.
#
# import `shared.kiru`;
#
# Imports are processed at their source position, so you can interpolate
# global variables into the path:
#
# var string dir = `configs`;
# import `${global::dir}/common.kiru`;

# ── 3. FUNCTIONS (top-level templates) ──────────────────────────────
#
# Functions are defined at the top level, NOT inside projects.
# They are templates: use $self:: to reference the project that will
# eventually host the function. When applied via use, self:: gets
# rewritten to that project's name.
#
# Inside a global function template, none of the body statements execute
# at declaration time. They are stored as AST and only resolved when the
# function is applied to a project via use.
#
# A function body can contain:
#
#   log  `message`;         print a message
#   exec `command`;         run a shell command (live output)
#   cd   `path`;            change directory (persistent, relative joins)
#
#   var string x = `val`;   project-scoped variable (visible to all fns)
#   var shell  x = `cmd`;   shell variable (runs in the project dir when
#                            the function is applied via use; never runs
#                            at function declaration time)
#
#   env [KEY = `val`] {     scoped env vars for the block
#       ...;
#   };
#
#   case $cond {            branching — first match wins
#       `literal` { ... };
#       $var_ref  { ... };  match against a variable's value
#       _         { ... };  default / catch-all
#   };

fn check {
    log `Running static checks for ${global::app}...`;
    exec `go fmt ./...`;
    exec `go vet ./...`;
}

fn build {
    log `Building ${global::app}...`;

    case $global::os {
        `Linux` {
            env [GOOS = `linux` GOARCH = `amd64`] {
                exec `go build -o bin/${global::app} .`;
            };
        };
        `Darwin` {
            cd `cmd`;
            exec `go build -o ../bin/${global::app} .`;
        };
        _ {
            log `unsupported OS: ${global::os}, falling back to native build`;
            exec `go build -o bin/${global::app} .`;
        };
    };
}

fn test {
    log `Running tests for ${global::app}...`;
    var string gopath = `/home/user/.local/share/go`;

    env [
        CGO_ENABLED = `0`
        GOPATH = $self::gopath
    ] {
        log `Testing go program`;
        exec `go test -race ./...`;
    };
}

fn lint {
    exec `golangci-lint run ./...`;
}

fn release {
    var string tag = `v1.0.0`;
    case $self::tag {
        `` {
            log `no git tag found, skipping release`;
        };
        _ {
            log `releasing ${self::tag}...`;
            exec `docker build -t ${self::docker_registry}/${global::app}:${self::tag} .`;
            exec `docker push ${self::docker_registry}/${global::app}:${self::tag}`;
        };
    };
}

# ── 4. PROJECTS (declare repos + apply functions) ──────────────────
#
# pr <name> [field = value ...] { <body> }
#
# Fields (space-separated, inside brackets):
#   url     — git remote URL
#   dir     — local directory (relative paths resolve against this file)
#   sync    — "ignore" (optional; repos are cloned/updated by default)
#   branch  — git branch to clone (optional)
#
# Project body (inside the braces):
#   var <type> <name> = <value>;     project-scoped variable
#   use <function> [as <alias>];     apply a global function to this project

pr myapp [
    url  = `git@github.com:${global::user}/myapp.git`
    dir  = `${global::app}`
    branch = `main`
] {
    var string docker_registry = `ghcr.io/${global::user}`;
    var string port = `3000`;

    # Apply global functions. They become myapp::check, myapp::build, etc.
    # $self:: inside a function body now refers to myapp's variables.
    use check;
    use build;
    use test;
    use lint;
    use release;
}

# ── 5. RUN BLOCKS (orchestration) ──────────────────────────────────
#
# Run blocks are top-level. They orchestrate functions across projects.
#
#   ;   separates parallel chains
#   =>  sequences functions within a chain
#
# All chains start at once. If one function in a chain fails, the rest
# of that chain is skipped but other chains continue.

run all {
    myapp::lint => myapp::check => myapp::build;
    myapp::test;
}

run ci {
    myapp::lint => myapp::test;
}
