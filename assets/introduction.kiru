# kiru - introduction
#
# This file walks through the language, feature by feature.
# Each section builds on the last; the file compiles as it stands.
#
# Try it after reading:
#   kiru compile -c intro.kiru -o .   # turn this into a kirufile
#   kiru status -p kirufile           # see what kiru found
#   kiru run all -p kirufile          # run the pipeline at the bottom

# -- 1. VARIABLES -----------------------------------------------------
#
# A var holds a value you can reuse.
#
#   var name = (text);      the text as-is
#   var name = $(command);  run the command now and keep its output
#
# A failed $(command) is not an error; it leaves "". Handy for probing,
# e.g. var has_docker = $(command -v docker).
#
# Use @(name) later to use the value again.

var app  = (myapp);
var user = (yourname);
var os   = $(uname -s);

# @(app) works inside any template, so this builds a name out of parts:
var repo = (@(user)/@(app));

# -- 2. IMPORT --------------------------------------------------------
#
# Pull in another file with import. The path is a template and is
# relative to the importing file:
#
#   import (./shared.kiru);
#
# Variables already in scope work in the path too:
#
#   var dir = (~/configs);
#   import (@(dir)/common.kiru);

# -- 3. FUNCTIONS -----------------------------------------------------
#
# A project (pr) groups functions that act on the same repo. Each
# function is a list of steps:
#
#   log  (msg);           print a message
#   $(cmd);               run a shell command (live output)
#   cd  (path);           change directory for the rest of the function
#
#   var name = (val);     a value shared by this project's functions
#   var name = $(cmd);    same, but captured when you run kiru compile
#
#   env { KEY = (val); } {    run a block with extra environment
#       ...;
#   };
#
#   switch @(x) {             run the first case that matches
#       case (value) { ... };
#       case _ { ... };       everything else
#   };

pr myapp {
  var docker_registry = (ghcr.io/@(user));
  var port = (3000);

  fn check {
    log (Running static checks for @(app)...);
    $(go fmt ./...);
    $(go vet ./...);
  }

  fn build {
    log (Building @(app)...);

    switch @(os) {
      case (Linux) {
        env {
          GOOS = (linux);
          GOARCH = (amd64);
        } {
          $(go build -o bin/@(app) .);
        };
      };
      case (Darwin) {
        cd (cmd);
        $(go build -o ../bin/@(app) .);
      };
      case _ {
        log (unsupported OS: @(os), falling back to native build);
        $(go build -o bin/@(app) .);
      };
    };
  }

  fn test {
    log (Running tests for @(app)...);
    var gopath = (/home/user/.local/share/go);

    env {
      CGO_ENABLED = (0);
      GOPATH = @(gopath);
    } {
      log (Testing go program);
      $(go test -race ./...);
    };
  }

  fn lint {
    $(golangci-lint run ./...);
  }

  fn release {
    var tag = (v1.0.0);
    switch @(tag) {
      case () {
        log (no git tag found, skipping release);
      };
      case _ {
        log (releasing @(tag)...);
        $(docker build -t @(docker_registry)/@(app):@(tag) .);
        $(docker push @(docker_registry)/@(app):@(tag));
      };
    };
  }
}

# -- 4. RUN BLOCKS ----------------------------------------------------
#
# A run block calls functions across projects as a pipeline.
#
#   ;   means "at the same time"
#   =>  means "wait for the one before"
#
# Each ;-separated line starts at once. If a step in a chain fails, the
# rest of that chain is skipped, but the other chains keep going.

run all {
  myapp::lint => myapp::check => myapp::build;   # one after another
  myapp::test;                                   # alongside the chain above
}

run ci {
  myapp::lint => myapp::test;
}
