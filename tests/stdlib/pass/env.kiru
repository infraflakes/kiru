# The env helpers: var, current_dir, temp_dir.

use std;
use std::text;
use std::vec;
use std::env;

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  let unset: txt = match std::env::var("KIRU_DEFINITELY_UNSET_VAR") {
    std::Option.some(value) => value;
    std::Option.none => "absent";
  };
  check("an unset variable is the absence", unset, "absent");
  check("current_dir is nonempty", "@(std::env::current_dir().len() > 0)", "true");
  check("temp_dir is nonempty", "@(std::env::temp_dir().len() > 0)", "true");
  std::print("env: ok");
};
