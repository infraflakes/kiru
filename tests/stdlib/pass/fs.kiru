# The fs helpers: write, append, read, exists, remove, temp_file, glob.

use std;
use std::text;
use std::vec;
use std::fs;

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  let path: txt = std::fs::temp_file();
  std::fs::write(path, "a");
  std::fs::append(path, "b");
  check("read returns what write and append wrote", std::fs::read(path), "ab");
  check("exists is true for a written file", "@(std::fs::exists(path))", "true");
  std::fs::remove(path);
  check("exists is false after remove", "@(std::fs::exists(path))", "false");

  let first: txt = std::fs::temp_file();
  let second: txt = std::fs::temp_file();
  check("temp_file makes two different paths", "@(first != second)", "true");
  check("the first temp file exists", "@(std::fs::exists(first))", "true");
  check("the second temp file exists", "@(std::fs::exists(second))", "true");
  std::fs::remove(first);
  check("the first temp file is gone", "@(std::fs::exists(first))", "false");
  std::fs::remove(second);

  let made: std::Output = std::command("mktemp -d").capture();
  let dir: txt = std::text::trim(made.out);
  std::fs::write(std::path::join(dir, "a.txt"), "");
  std::fs::write(std::path::join(dir, "b.txt"), "");
  std::fs::write(std::path::join(dir, "c.log"), "");
  let matches: txt = std::join(std::fs::glob(std::path::join(dir, "*.txt")), "|");
  check("glob lists a.txt", "@(matches.contains("a.txt"))", "true");
  check("glob lists b.txt", "@(matches.contains("b.txt"))", "true");
  check("glob skips c.log", "@(matches.contains("c.log"))", "false");
  check("glob returns sorted matches", "@(matches.find("a.txt").or(99) < matches.find("b.txt").or(-1))", "true");
  std::command("rm -rf @(std::quote(dir))").run();

  std::print("fs: ok");
};
