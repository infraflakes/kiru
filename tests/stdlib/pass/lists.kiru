# The vec methods: len, index, add, reverse, first, last, concat, contains, sort.

use std;
use std::text;
use std::vec;

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  let xs: Vec<txt> = ["a", "b", "c"];
  check("len", "@(xs.len())", "3");
  check("index", xs[1], "b");
  check("add then join", std::join(["a", "b"].with("c"), "-"), "a-b-c");
  check("reverse", std::join(["a", "b", "c"].reversed(), ""), "cba");
  check("first", ["a", "b", "c"].first(), "a");
  check("last", ["a", "b", "c"].last(), "c");
  check("concat joins two vec in order", std::join(["a", "b"].concat(["c", "d"]), ""), "abcd");
  check("concat with an empty vec", std::join([].concat(["a"]), ""), "a");
  check("contains present", "@(["a", "b"].contains("b"))", "true");
  check("contains absent", "@(["a", "b"].contains("z"))", "false");
  check("find finds the first index", "@(["a", "b", "a"].find("a").or(-1))", "0");
  check("find finds a later element", "@(["a", "b", "a"].find("b").or(-1))", "1");
  check("find reports an absent element", "@(["a", "b"].find("z").or(-1))", "-1");
  check("unique drops adjacent duplicates", std::join(["a", "a", "b", "b", "c"].uniqued(), ""), "abc");
  check("unique keeps separated duplicates", std::join(["a", "b", "a"].uniqued(), ""), "aba");
  check("sort then unique is unique", std::join(std::vec::sorted(["b", "a", "b", "a"]).uniqued(), ""), "ab");
  check("sort orders text ascending", std::join(std::vec::sorted(["c", "a", "b"]), ""), "abc");
  std::print("vec: ok");
};
