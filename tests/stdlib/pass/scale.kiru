# Copy-on-write must behave exactly like a copy: writing one value never
# changes another. The scale section also builds a long concat chain, so a deep
# rope is flattened and dropped without overflowing the stack.

use std;
use std::text;
use std::vec;

# A record the copy-on-write checks below copy and then write.
rec Named { name: txt };

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  # A vec copy is independent of its source.
  let xs: Vec<txt> = ["a", "b", "c"];
  let ys: Vec<txt> = xs;
  ys[0] = "z";
  check("a written vec copy leaves the source", std::join(xs, ""), "abc");
  check("the vec copy sees its own write", std::join(ys, ""), "zbc");

  # A record copy is independent of its source.
  let original: Named = { name = "one" };
  let copied: Named = original;
  copied.name = "two";
  check("a written record copy leaves the source", original.name, "one");
  check("the record copy sees its own write", copied.name, "two");

  # A long concat chain flattens and drops without a stack overflow.
  let parts: Vec<txt> = [];
  let i: int = 0;
  for {
    match i < 4000 { false => { break; }; true => {}; };
    parts[i] = "ab";
    i = i + 1;
  };
  let joined: txt = std::join(parts, "-");
  check("join at scale", "@(joined.len())", "11999");
  check("join keeps the last part", "@(joined.ends_with("ab"))", "true");

  let reversed: Vec<txt> = parts.reversed();
  check("reverse at scale", reversed[0], "ab");
  let both: Vec<txt> = parts.concat(reversed);
  check("concat at scale", "@(both.len())", "8000");

  std::print("scale: ok");
};
