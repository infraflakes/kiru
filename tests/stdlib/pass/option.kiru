# The Option methods: some, none, or, has.

use std;
use std::text;
use std::vec;

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  let some: std::Option<int> = std::Option.some(7);
  check("some wraps a value", "@(some.or(0))", "7");
  check("contains on some", "@(some.contains())", "true");
  let none: std::Option<int> = std::Option.none;
  check("none falls back", "@(none.or(42))", "42");
  check("contains on none", "@(none.contains())", "false");
  let xs: Vec<int> = [1, 2, 3, 4];
  check("a generic len works for any element type", "@(xs.len())", "4");
  std::print("option: ok");
};
