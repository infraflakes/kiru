# The map type and its methods. `Map<K, V>` is a rec over a vec of entries, so
# these checks exercise the type as ordinary kiru: construction, lookup with
# `get` and `get_or`, replacement, and the key/value/len walks. `Entry` and
# `Map.entries` are private to `std::map`, so a program builds entries with a
# `{ … }` literal whose shape `of` gives it, and never names the entry type.

use std;
use std::map;
use std::text;
use std::vec;

fn check(name: txt, got: txt, want: txt) {
  match got == want {
    true => {};
    false => { std::fail("@(name): expected `@(want)`, found `@(got)`"); };
  };
};

fn main() {
  let empty: std::map::Map<txt, txt> = std::map::empty();
  check("empty has no entries", "@(empty.len())", "0");

  let m: std::map::Map<txt, txt> = std::map::of([
    { key = "a", value = "1" },
    { key = "b", value = "2" },
    { key = "a", value = "3" },
  ]);
  check("a later entry replaces an earlier key", "@(m.len())", "2");
  check("get reads a present key", m.get("a"), "3");
  check("get reads a later key", m.get("b"), "2");
  check("get_or reads a present key", m.get_or("a", "missing"), "3");
  check("get_or falls back for a missing key", m.get_or("z", "missing"), "missing");
  check("contains is true for a present key", "@(m.contains("a"))", "true");
  check("contains is false for a missing key", "@(m.contains("z"))", "false");
  check("keys keep insertion order", std::join(m.keys(), ","), "a,b");
  check("values keep insertion order", std::join(m.values(), ","), "3,2");

  let replaced: std::map::Map<txt, txt> = m.with("a", "9");
  check("insert replaces in place", replaced.get("a"), "9");
  check("insert keeps the original", m.get("a"), "3");
  let appended: std::map::Map<txt, txt> = replaced.with("c", "7");
  check("insert appends a new key", "@(appended.len())", "3");
  check("the appended key reads back", appended.get("c"), "7");
  check("keys keep their place after insert", std::join(appended.keys(), ","), "a,b,c");

  std::print("map: ok");
};
