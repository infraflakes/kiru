pr nix {
  var name = (nixenv);
  
  fn ssh {
    var check_ssh = $(test -f "$HOME/.ssh/id_ed25519.pub" && git remote get-url origin 2>/dev/null | grep -q "^https://" && echo "1");
    switch check_ssh {
      case (1) {
        log (Switching url source...);
        $(git remote set-url origin git@github.com:infraflakes/@(name).git);
      };
      case _ {
        log (Source is already switched, or not enough condition.);
      };
    };
  };

  fn update {
    log (Pulling new changes...);
    $(git pull);
  };
  fn eval {
    log (Building flake home manager...);
    $(home-manager switch --flake .#nixenv@container);
  };
};

pr dots {
  var name = (dots);

  fn ssh {
    var check_ssh = $(test -f "$HOME/.ssh/id_ed25519.pub" && git remote get-url origin 2>/dev/null | grep -q "^https://" && echo "1");
    switch check_ssh {
      case (1) {
        log (Switching url source...);
        $(git remote set-url origin git@github.com:infraflakes/@(name).git);
      };
      case _ {
        log (Source is already switched, or not enough condition.);
      };
    };
  };

  fn update {
    log (Pulling new changes...);
    $(git pull);
  };

  fn init {
    $(test -f ~/.config/fish/config.fish && echo "1") -> fish_exist;
    switch fish_exist {
      case (1) {
        log (Symlinking with stow...);
        $(stow --adopt -t @(config_dir) config);
        $(git restore config/fish);
      };
     case _ {
        log (Symlinking with stow...);
        $(stow -t @(config_dir) config);
      };
    };
  };

  fn remove {
    log (Removing stow's symlink...);
    $(stow -D -t @(config_dir) config);
  };
};

run bootstrap {
  nix::eval => nix::ssh;
  dots::init;
};

pr devenv {
  var name = (devenv);

  fn ssh {
    var check_ssh = $(test -f "$HOME/.ssh/id_ed25519.pub" && git remote get-url origin 2>/dev/null | grep -q "^https://" && echo "1");
    switch check_ssh {
      case (1) {
        log (Switching url source...);
        $(git remote set-url origin git@github.com:infraflakes/@(name).git);
      };
      case _ {
        log (Source is already switched, or not enough condition.);
      };
    };
  };

  fn update {
    log (Pulling new changes...);
    $(git pull);
  };

  fn build_test {
    var kernel_version = $(uname -v);
    env {
      CGO_ENABLED = (0);
      GOOS = (linux);
      VERSION = @(kernel_version);
    } {
      cd (project);
      $(go build ./...);
    };
  };
};
