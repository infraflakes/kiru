import ./seq.sro;
import ./par.sro;

pr sro {

  fn init {
    exec `nix develop -c make init`;
  }
  
  fn clean {
    exec `rm -rf bin`;
    exec `rm -rf result`;
  }

  fn fmt {
    exec `cargo clippy --fix --allow-dirty`;
    exec `cargo fmt`;
  }

  fn test {
    exec `nix develop -c cargo test`;
    exec `nix develop -c cargo clippy`;
    exec `nix develop -c cargo fmt --check`;
  }

  fn build {
      var shell docker_bin = `command -v docker 2> /dev/null || command -v podman 2> /dev/null`;
      case ($docker_bin) {
        `` { log `no container runtime found`; };
        _  { exec `rm -rf bin`;
                  exec `rm -rf result`;
                  exec `${docker_bin} build --output type=local,dest=bin .`; };
      };
  }
}
