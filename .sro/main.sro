import ./seq.sro;
import ./par.sro;

pr sro {

  fn init {
    exec `nix develop -c cargo check`;
  }

  fn clean {
    log `Cleaning up artifacts...`;
    exec `rm -rf bin`;
    exec `rm -rf result`;
  }

  fn fmt {
    log `Formatting the codebase...`;
    exec `nix develop -c cargo clippy --fix --allow-dirty`;
    exec `nix develop -c cargo fmt`;
  }

  fn test {
    log `Testing the codebase!`;
    exec `nix develop -c cargo test`;
    exec `nix develop -c cargo clippy`;
    exec `nix develop -c cargo fmt --check`;
  }

  fn build {
      var shell docker_bin = `command -v docker 2> /dev/null || command -v podman 2> /dev/null || true`;
      case $docker_bin {
        `` { log `no container runtime found`;
             exec `exit 1`; };
        _  { exec `rm -rf bin`;
                  exec `rm -rf result`;
                  exec `${docker_bin} build --output type=local,dest=bin .`; };
      };
  }
}
