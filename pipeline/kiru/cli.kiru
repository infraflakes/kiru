let usage_kiru: txt = "usage: kiru <flag>

flags:
check      run the checks
build      build the binary
container  docker or podman build into bin
format     apply clippy and rustfmt fixes
update     cargo update and cargo upgrade";

let usage_docs: txt = "usage: docs <flag>

flags:
build   build the site
check   check the site
format  apply biome fixes
update  bun update and biome migrate
serve   preview the site";

let usage_all: txt = "usage: all <flag>

flags:
build   build both docs and backend
check   check both docs and backend
format  format both docs and backend
update  update both docs and backend
ci      check and build both";

pub fn usage() -> txt { return "@(usage_kiru)\n\n@(usage_docs)\n\n@(usage_all)"; };

fn container_cmd() -> txt {
  match std::process::command("command -v docker").stream(std::process::Stream.stdout, "/dev/null").stream(std::process::Stream.stderr, "/dev/null").run() {
    0 => {
      return "docker";
    };
    _ => {
      match std::process::command("command -v podman").stream(std::process::Stream.stdout, "/dev/null").stream(std::process::Stream.stderr, "/dev/null").run() {
        0 => {
          return "podman";
        };
        _ => {
          std::eprint("No container binary found.");
        };
      };
    };
  };
};

pub fn kiru_command(project: Project, flag: txt) -> int {
  match flag {
    "check" => { return check_kiru(project); };
    "build" => { return build_kiru(project); };
    "container" => {
      return run(project, "@(container_cmd()) build --output type=local,dest=bin .");
    };
    "format" => { return format_kiru(project); };
    "update" => { return update_kiru(project); };
    _ => { std::eprint(usage_kiru); return 1; };
  };
};

pub fn docs_command(docs: Project, flag: txt) -> int {
  match flag {
    "build" => { return build_docs(docs); };
    "check" => { return check_docs(docs); };
    "format" => { return format_docs(docs); };
    "update" => { return update_docs(docs); };
    "serve" => { return run(docs, "bun run preview"); };
    _ => { std::eprint(usage_docs); return 1; };
  };
};

pub fn all_command(kiru: Project, docs: Project, flag: txt) -> int {
  match flag {
    "build" => {
      std::log("Building site");
      let code: int = build_docs(docs);
      match code { 0 => {}; _ => { return code; }; };
      std::log("Building backend");
      return build_kiru(kiru);
    };
    "update" => {
      let updated: int = run(kiru, "nix flake update");
      match updated { 0 => {}; _ => { return updated; }; };
      std::log("Updating backend");
      let backend: int = update_kiru(kiru);
      match backend { 0 => {}; _ => { return backend; }; };
      std::log("Updating site");
      return update_docs(docs);
    };
    "format" => {
      std::log("Formatting site");
      let site: int = format_docs(docs);
      match site { 0 => {}; _ => { return site; }; };
      std::log("Formatting backend");
      return format_kiru(kiru);
    };
    "check" => {
      std::log("Starting backend checks");
      let backend: int = check_kiru(kiru);
      match backend { 0 => {}; _ => { return backend; }; };
      std::log("Starting site checks");
      return check_docs(docs);
    };
    "ci" => {
      std::log("Starting backend checks");
      let backend: int = check_kiru(kiru);
      match backend { 0 => {}; _ => { return backend; }; };
      std::log("Starting site checks");
      let site: int = check_docs(docs);
      match site { 0 => {}; _ => { return site; }; };
      std::log("Building backend");
      let built_backend: int = build_kiru(kiru);
      match built_backend { 0 => {}; _ => { return built_backend; }; };
      std::log("Building site");
      return build_docs(docs);
    };
    _ => { std::eprint(usage_all); return 1; };
  };
};
