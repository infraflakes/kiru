# std.kiru
#
# The standard library's root: the `std` namespace, and the tree of categories
# below it. This file's declarations join `std`; every other stdlib file joins
# the namespace its directory names. The library writes full paths and uses no
# `use`, so every name reads as its absolute path.

# Write a prefix and a message, coloring the prefix on a terminal. `color` is
# an ANSI SGR code and `file_descriptor` is 1 for stdout or 2 for stderr.
fn emit(color: txt, prefix: txt, file_descriptor: int, message: txt) {
  std::syscalls::write(file_descriptor, match std::syscalls::isatty(file_descriptor) {
    true => "\e[@(color)m@(prefix)\e[0m @(message)\n";
    _ => "@(prefix) @(message)\n";
  });
};

# Write a line to stdout.
pub fn print(message: txt) {
  std::syscalls::write(1, "@(message)\n");
};

# Write an "INFO:" line to stdout, yellow on a terminal.
pub fn log(message: txt) {
  std::emit("33", "INFO:", 1, message);
};

# Write an "ERROR:" line to stderr, red on a terminal, then stop the run.
pub fn eprint(message: txt) {
  std::emit("31", "ERROR:", 2, message);
  panic;
};

# A value that is either present (`some`) or absent (`none`).
pub enum Option<T> { pub some(T), pub none };

impl Option {
  # The value inside `self`, or `fallback` when it is `none`.
  pub fn or<T>(self: std::Option<T>, fallback: T) -> T {
    let inner: T = match self {
      std::Option.some(value) => value;
      std::Option.none => fallback;
    };
    return inner;
  };

  # Whether `self` holds a value.
  pub fn contains<T>(self: std::Option<T>) -> bool {
    let present: bool = match self {
      std::Option.some(_) => true;
      std::Option.none => false;
    };
    return present;
  };
};
