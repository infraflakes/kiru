# std/cli.kiru
#
# A command tree. Declare commands and their flags, link them with the
# `add_child` method, then parse the words: the tree descends by the leading words,
# accumulates the flags of the ancestors, and runs the leaf's action with a
# `Context` the readers read.
#
# The functions in the `impl` blocks below are filed under their types: those
# with the type as their first parameter are methods, so a command reads as one
# chain of absolute calls:
#
#   std::cli::action(
#     std::cli::flag(
#       std::cli::about(std::cli::command("build"), "build it"),
#       std::cli::short(std::cli::help(std::cli::bool_flag("--verbose"), "more output"), "-v")),
#     run)
#
# and `std::cli::parse(tree, words)` runs it. `command`, `bool_flag`, and
# `value_flag` build the values and are plain functions.
#
# This file writes full paths: it uses no `use`, and every bound function is
# reached through its absolute path.

# One flag a command accepts.
pub rec Flag {
  name: txt,      # "--verbose"
  short: txt,     # "-v", or ""
  help: txt,      # the help line
  takes: bool,    # true when it takes a value
  fallback: txt,  # the value when the flag is absent
};

# The parsed command line handed to an action.
pub rec Context {
  path: std::dynamic::Vec<txt>,           # the command path, such as "kiru build"
  flags: std::dynamic::Vec<std::cli::Flag>,  # this command's flags plus its ancestors'
  words: std::dynamic::Vec<txt>,          # what is left to read
};

# One command in the tree.
pub rec Subcommand {
  name: txt,
  about: txt,
  flags: std::dynamic::Vec<std::cli::Flag>,
  children: std::dynamic::Vec<std::cli::Subcommand>,
  action: fn(std::cli::Context) -> int,
};

# Start a command: no about line, no children, and no action yet. Every command
# carries the help flag, so `--help` and `-h` are declared where the command is
# declared and need no scan of their own.
pub fn command(name: txt) -> std::cli::Subcommand {
  return {
    name = name,
    about = "",
    flags = std::dynamic::push(std::dynamic::Vec.new(), std::cli::help_flag()),
    children = std::dynamic::Vec.new(),
    action = std::cli::Context.no_action,
  };
};

# The help flag every command carries.
pub fn help_flag() -> std::cli::Flag {
  return std::cli::short(std::cli::help(std::cli::bool_flag("--help"), "show this help"), "-h");
};

# Start a flag that is present or absent.
pub fn bool_flag(name: txt) -> std::cli::Flag {
  return {
    name = name,
    short = "",
    help = "",
    takes = false,
    fallback = "",
  };
};

# Start a flag that takes a value.
pub fn value_flag(name: txt) -> std::cli::Flag {
  let flag: std::cli::Flag = std::cli::bool_flag(name);
  flag.takes = true;
  return flag;
};

# Whether `word` is a flag word. It takes a text and belongs to no type, so it
# is a plain function.
fn is_flag(word: txt) -> bool {
  return std::text::starts_with(word, "-");
};

# The flag `word` names, if any.
fn flag_named(flags: std::dynamic::Vec<std::cli::Flag>, word: txt) -> std::Option<std::cli::Flag> {
  let index: int = 0;
  let count: int = std::dynamic::len(flags);
  for {
    match index < count { false => { break; }; true => {}; };
    let flag: std::cli::Flag = std::dynamic::at(flags, index);
    match flag.named(word) {
      true => { return std::Option.some(flag); };
      _ => {};
    };
    index = index + 1;
  };
  return std::Option.none;
};

# The words a scan separates: flags the tree does not declare, and words that
# are neither a flag nor a flag's value.
rec WordScan {
  unknown: std::dynamic::Vec<txt>,
  args: std::dynamic::Vec<txt>,
};

# Walk `words` once, separating the flags `flags` does not declare from the
# arguments. A word after a declared value-taking flag is that flag's value, so
# it is neither a flag nor an argument.
fn scan(words: std::dynamic::Vec<txt>, flags: std::dynamic::Vec<std::cli::Flag>) -> std::cli::WordScan {
  let out: std::cli::WordScan = {
    unknown = std::dynamic::Vec.new(),
    args = std::dynamic::Vec.new(),
  };
  let skip: bool = false;
  let index: int = 0;
  let count: int = std::dynamic::len(words);
  for {
    match index < count { false => { break; }; true => {}; };
    let word: txt = std::dynamic::at(words, index);
    match skip {
      true => { skip = false; };
      _ => {
        match std::cli::is_flag(word) {
          true => {
            match std::cli::flag_named(flags, word) {
              std::Option.some(flag) => {
                match flag.takes {
                  true => { skip = true; };
                  _ => {};
                };
              };
              std::Option.none => { out.unknown = std::dynamic::push(out.unknown, word); };
            };
          };
          _ => { out.args = std::dynamic::push(out.args, word); };
        };
      };
    };
    index = index + 1;
  };
  return out;
};

# The first flag in `words` that `flags` does not declare, or
# `std::Option.none` when every flag is known.
fn unknown(words: std::dynamic::Vec<txt>, flags: std::dynamic::Vec<std::cli::Flag>) -> std::Option<txt> {
  let scanned: std::cli::WordScan = std::cli::scan(words, flags);
  match std::dynamic::len(scanned.unknown) > 0 {
    true => { return std::Option.some(std::dynamic::at(scanned.unknown, 0)); };
    _ => {};
  };
  return std::Option.none;
};

# The word after `flag`, or the flag's fallback.
fn value_of(words: std::dynamic::Vec<txt>, flag: std::cli::Flag) -> txt {
  let index: int = 0;
  let count: int = std::dynamic::len(words);
  for {
    match index < count { false => { break; }; true => {}; };
    let word: txt = std::dynamic::at(words, index);
    match flag.named(word) {
      true => {
        let next: int = index + 1;
        match next < count {
          true => { return std::dynamic::at(words, next); };
          _ => {};
        };
      };
      _ => {};
    };
    index = index + 1;
  };
  return flag.fallback;
};

impl Context {
  # The action of a command that has none: report it and fail. It is a method,
  # so its value is reached as `std::cli::Context.no_action`.
  pub fn no_action(context: std::cli::Context) -> int {
    let line: txt = std::dynamic::join(context.path, " ");
    std::eprint("no action for `@(line)`");
    return 1;
  };

  # Whether the flag was given.
  pub fn contains(self: std::cli::Context, flag: std::cli::Flag) -> bool {
    let index: int = 0;
    let count: int = std::dynamic::len(self.words);
    for {
      match index < count { false => { break; }; true => {}; };
      let word: txt = std::dynamic::at(self.words, index);
      match flag.named(word) {
        true => { return true; };
        _ => {};
      };
      index = index + 1;
    };
    return false;
  };

  # The value after the flag, or the flag's fallback.
  pub fn value(self: std::cli::Context, flag: std::cli::Flag) -> txt {
    return std::cli::value_of(self.words, flag);
  };

  # The value after the flag as a whole number, or the flag's fallback. A value
  # that is not a whole number stops the run.
  pub fn number(self: std::cli::Context, flag: std::cli::Flag) -> int {
    let raw: txt = std::cli::value_of(self.words, flag);
    match std::text::number(raw) {
      std::Option.some(value) => { return value; };
      std::Option.none => { std::eprint("`@(flag.name)` needs a whole number, found `@(raw)`"); };
    };
  };

  # The words that are neither flags nor flag values.
  pub fn args(self: std::cli::Context) -> std::dynamic::Vec<txt> {
    let scanned: std::cli::WordScan = std::cli::scan(self.words, self.flags);
    return scanned.args;
  };
};

impl Flag {
  # Whether `word` names this flag: its long name or its short form.
  pub fn named(self: std::cli::Flag, word: txt) -> bool {
    return self.name == word || self.short == word;
  };

  # This flag with its short form.
  pub fn short(self: std::cli::Flag, short: txt) -> std::cli::Flag {
    let copy: std::cli::Flag = self;
    copy.short = short;
    return copy;
  };

  # This flag with its help line.
  pub fn help(self: std::cli::Flag, text: txt) -> std::cli::Flag {
    let copy: std::cli::Flag = self;
    copy.help = text;
    return copy;
  };

  # This flag with the value it falls back to when it is absent.
  pub fn fallback(self: std::cli::Flag, value: txt) -> std::cli::Flag {
    let copy: std::cli::Flag = self;
    copy.fallback = value;
    return copy;
  };
};

impl Subcommand {
  # This command with its about line.
  pub fn about(self: std::cli::Subcommand, text: txt) -> std::cli::Subcommand {
    let copy: std::cli::Subcommand = self;
    copy.about = text;
    return copy;
  };

  # This command with one more flag.
  pub fn flag(self: std::cli::Subcommand, flag: std::cli::Flag) -> std::cli::Subcommand {
    let copy: std::cli::Subcommand = self;
    copy.flags = std::dynamic::push(copy.flags, flag);
    return copy;
  };

  # This command with one more child.
  pub fn add_child(self: std::cli::Subcommand, child: std::cli::Subcommand) -> std::cli::Subcommand {
    let copy: std::cli::Subcommand = self;
    copy.children = std::dynamic::push(copy.children, child);
    return copy;
  };

  # This command with its action.
  pub fn action(self: std::cli::Subcommand, handler: fn(std::cli::Context) -> int) -> std::cli::Subcommand {
    let copy: std::cli::Subcommand = self;
    copy.action = handler;
    return copy;
  };

  # The usage text for this command: its name and about line, then its children
  # and flags.
  pub fn usage(self: std::cli::Subcommand) -> txt {
    let out: txt = "@(self.name): @(self.about)\n";
    let index: int = 0;
    let count: int = std::dynamic::len(self.children);
    for {
      match index < count { false => { break; }; true => {}; };
      let child: std::cli::Subcommand = std::dynamic::at(self.children, index);
      out = "@(out)  @(child.name)  @(child.about)\n";
      index = index + 1;
    };
    index = 0;
    count = std::dynamic::len(self.flags);
    for {
      match index < count { false => { break; }; true => {}; };
      let flag: std::cli::Flag = std::dynamic::at(self.flags, index);
      out = "@(out)  @(flag.name)  @(flag.help)\n";
      index = index + 1;
    };
    return out;
  };

  # Descend the tree by the leading words, then run the command the words name.
  # The descent walks `words` by index and slices the remainder once, so a deep
  # command path does not rebuild the word vec at every step.
  pub fn parse(self: std::cli::Subcommand, words: std::dynamic::Vec<txt>) -> int {
    let current: std::cli::Subcommand = self;
    let path: std::dynamic::Vec<txt> = std::dynamic::push(std::dynamic::Vec.new(), self.name);
    let flags: std::dynamic::Vec<std::cli::Flag> = self.flags;
    let count: int = std::dynamic::len(words);
    let at: int = 0;
    for {
      match at < count { false => { break; }; true => {}; };
      let child: std::Option<std::cli::Subcommand> = std::Option.none;
      let index: int = 0;
      let children: int = std::dynamic::len(current.children);
      for {
        match index < children { false => { break; }; true => {}; };
        let candidate: std::cli::Subcommand = std::dynamic::at(current.children, index);
        match candidate.name == std::dynamic::at(words, at) {
          true => { child = std::Option.some(candidate); break; };
          _ => {};
        };
        index = index + 1;
      };
      match std::contains(child) {
        true => {
          current = match child {
            std::Option.some(next) => next;
            std::Option.none => current;
          };
          path = std::dynamic::push(path, current.name);
          let flag_index: int = 0;
          let flag_count: int = std::dynamic::len(current.flags);
          for {
            match flag_index < flag_count { false => { break; }; true => {}; };
            flags = std::dynamic::push(flags, std::dynamic::at(current.flags, flag_index));
            flag_index = flag_index + 1;
          };
          at = at + 1;
        };
        _ => { break; };
      };
    };
    let rest: std::dynamic::Vec<txt> = std::dynamic::Vec.new();
    let rest_index: int = 0;
    for {
      match rest_index < count { false => { break; }; true => {}; };
      match rest_index >= at { true => { rest = std::dynamic::push(rest, std::dynamic::at(words, rest_index)); }; _ => {}; };
      rest_index = rest_index + 1;
    };
    let context: std::cli::Context = {
      path = path,
      flags = flags,
      words = rest,
    };
    match context.contains(std::cli::help_flag()) {
      true => { std::print(std::cli::usage(current)); return 0; };
      _ => {};
    };
    let bad: std::Option<txt> = std::cli::unknown(rest, flags);
    match bad {
      std::Option.none => {};
      std::Option.some(word) => {
        let line: txt = std::cli::usage(current);
        std::eprint("unknown flag `@(word)`\n@(line)");
      };
    };
    let handler: fn(std::cli::Context) -> int = current.action;
    return handler(context);
  };
};
