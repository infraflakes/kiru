# std/cli.kiru
#
# A command tree. Declare commands and their flags, link them with `add`, then
# parse the words: the tree descends by the leading words, accumulates the flags
# of the ancestors, and runs the leaf's action with a `Context` the readers read.
#
# Everything is a method, so a command reads as one chain:
#
#   command("build").about("build it")
#     .flag(bool_flag("--verbose").short("-v").help("more output"))
#     .action(run)
#
# and `tree().parse(words)` runs it.

mod std::cli {

  # `Option` lives at the `std` root; `txt` and `Vec<T>` in their categories.
  use std;
  use std::text;
  use std::vec;

  # One flag a command accepts.
  pub rec Flag {
    name: txt,      # "--verbose"
    short: txt,     # "-v", or ""
    help: txt,      # the help line
    takes: bool,    # true when it takes a value
    fallback: txt,  # the value when the flag is absent
  };

  # The parsed command line handed to an action.
  pub rec Context {
    path: Vec<txt>,    # ["kiru", "build"]
    flags: Vec<Flag>,  # this command's flags plus its ancestors'
    words: Vec<txt>,   # what is left to read
  };

  # One command in the tree.
  pub rec Subcommand {
    name: txt,
    about: txt,
    flags: Vec<Flag>,
    children: Vec<Subcommand>,
    action: fn(Context) -> int,
  };

  # The action of a command that has none: report it and fail.
  fn no_action(context: Context) -> int {
    let line: txt = std::join(context.path, " ");
    std::eprint("no action for `@(line)`");
    return 1;
  };

  # Start a command: no about line, no flags, no children, and no action yet.
  pub fn command(name: txt) -> Subcommand {
    return {
      name = name,
      about = "",
      flags = [],
      children = [],
      action = no_action,
    };
  };

  # Start a flag that is present or absent.
  pub fn bool_flag(name: txt) -> Flag {
    return {
      name = name,
      short = "",
      help = "",
      takes = false,
      fallback = "",
    };
  };

  # Start a flag that takes a value.
  pub fn value_flag(name: txt) -> Flag {
    let flag: Flag = bool_flag(name);
    flag.takes = true;
    return flag;
  };

  # This command with its about line.
  pub fn about(self: Subcommand, text: txt) -> Subcommand {
    let copy: Subcommand = self;
    copy.about = text;
    return copy;
  };

  # This command with one more flag.
  pub fn flag(self: Subcommand, flag: Flag) -> Subcommand {
    let copy: Subcommand = self;
    copy.flags = copy.flags.with(flag);
    return copy;
  };

  # This command with one more child.
  pub fn with(self: Subcommand, child: Subcommand) -> Subcommand {
    let copy: Subcommand = self;
    copy.children = copy.children.with(child);
    return copy;
  };

  # This command with its action.
  pub fn action(self: Subcommand, handler: fn(Context) -> int) -> Subcommand {
    let copy: Subcommand = self;
    copy.action = handler;
    return copy;
  };

  # This flag with its short form.
  pub fn short(self: Flag, short: txt) -> Flag {
    let copy: Flag = self;
    copy.short = short;
    return copy;
  };

  # This flag with its help line.
  pub fn help(self: Flag, text: txt) -> Flag {
    let copy: Flag = self;
    copy.help = text;
    return copy;
  };

  # This flag with the value it falls back to when it is absent.
  pub fn fallback(self: Flag, value: txt) -> Flag {
    let copy: Flag = self;
    copy.fallback = value;
    return copy;
  };

  # The usage text for this command: its name and about line, then its children
  # and flags.
  pub fn usage(self: Subcommand) -> txt {
    let out: txt = "@(self.name): @(self.about)\n";
    for child in self.children {
      out = "@(out)  @(child.name)  @(child.about)\n";
    };
    for flag in self.flags {
      out = "@(out)  @(flag.name)  @(flag.help)\n";
    };
    return out;
  };

  # Whether `word` is a flag word.
  fn is_flag(word: txt) -> bool {
    return word.starts_with("-");
  };

  # The flag `word` names, if any.
  fn flag_named(flags: Vec<Flag>, word: txt) -> Option<Flag> {
    for flag in flags {
      match flag.name == word || flag.short == word {
        true => { return Option.some(flag); };
        _ => {};
      };
    };
    return Option.none;
  };

  # The first flag in `words` that `flags` does not declare, or the absence
  # when every flag is known. A word that follows a value-taking flag is a
  # value, not a flag. One lookup finds the flag and reads whether it takes a
  # value, so the scan is not repeated per word.
  fn unknown(words: Vec<txt>, flags: Vec<Flag>) -> Option<txt> {
    let skip: bool = false;
    for word in words {
      match skip {
        true => { skip = false; };
        _ => {
          match is_flag(word) {
            true => {
              match flag_named(flags, word) {
                Option.some(flag) => {
                  match flag.takes {
                    true => { skip = true; };
                    _ => {};
                  };
                };
                Option.none => { return Option.some(word); };
              };
            };
            _ => {};
          };
        };
      };
    };
    return Option.none;
  };

  # The word after `flag`, or the flag's fallback.
  fn value_of(words: Vec<txt>, flag: Flag) -> txt {
    let index: int = 0;
    for word in words {
      match word == flag.name || word == flag.short {
        true => {
          let next: int = index + 1;
          match next < words.len() {
            true => { return words[next]; };
            _ => {};
          };
        };
        _ => {};
      };
      index = index + 1;
    };
    return flag.fallback;
  };

  # Whether the flag was given.
  pub fn contains(self: Context, flag: Flag) -> bool {
    for word in self.words {
      match word == flag.name || word == flag.short {
        true => { return true; };
        _ => {};
      };
    };
    return false;
  };

  # The value after the flag, or the flag's fallback.
  pub fn value(self: Context, flag: Flag) -> txt {
    return value_of(self.words, flag);
  };

  # The value after the flag as a whole number, or the flag's fallback. A value
  # that is not a whole number stops the run.
  pub fn number(self: Context, flag: Flag) -> int {
    let raw: txt = value_of(self.words, flag);
    let parsed: Option<int> = raw.number();
    match parsed.contains() {
      true => {};
      _ => { std::eprint("`@(flag.name)` needs a whole number, found `@(raw)`"); };
    };
    let number: int = match parsed {
      std::Option.some(value) => value;
      std::Option.none => 0;
    };
    return number;
  };

  # The words that are neither flags nor flag values. The index tracks the
  # write position, so each argument appends in place.
  pub fn args(self: Context) -> Vec<txt> {
    let out: Vec<txt> = [];
    let at: int = 0;
    let skip: bool = false;
    for word in self.words {
      match skip {
        true => { skip = false; };
        _ => {
          match is_flag(word) {
            true => {
              match flag_named(self.flags, word) {
                Option.some(flag) => {
                  match flag.takes {
                    true => { skip = true; };
                    _ => {};
                  };
                };
                Option.none => {};
              };
            };
            _ => { out[at] = word; at = at + 1; };
          };
        };
      };
    };
    return out;
  };

  # Descend the tree by the leading words, then run the command the words name.
  # The descent walks `words` by index and slices the remainder once, so a deep
  # command path does not rebuild the word vec at every step.
  pub fn parse(self: Subcommand, words: Vec<txt>) -> int {
    let current: Subcommand = self;
    let path: Vec<txt> = [self.name];
    let flags: Vec<Flag> = self.flags;
    let count: int = words.len();
    let at: int = 0;
    for {
      match at < count { false => { break; }; true => {}; };
      let child: Option<Subcommand> = Option.none;
      for candidate in current.children {
        match candidate.name == words[at] {
          true => { child = Option.some(candidate); break; };
          _ => {};
        };
      };
      match child.contains() {
        true => {
          current = match child {
            std::Option.some(next) => next;
            std::Option.none => current;
          };
          path = path.with(current.name);
          for flag in current.flags { flags = flags.with(flag); };
          at = at + 1;
        };
        _ => { break; };
      };
    };
    let rest: Vec<txt> = [];
    let rest_at: int = 0;
    let rest_index: int = 0;
    for word in words {
      match rest_index >= at { true => { rest[rest_at] = word; rest_at = rest_at + 1; }; _ => {}; };
      rest_index = rest_index + 1;
    };
    let help: bool = false;
    for word in rest {
      match word == "--help" || word == "-h" { true => { help = true; break; }; _ => {}; };
    };
    match help {
      true => { std::print(current.usage()); return 0; };
      _ => {};
    };
    let bad: Option<txt> = unknown(rest, flags);
    match bad {
      Option.none => {};
      Option.some(word) => {
        let line: txt = current.usage();
        std::eprint("unknown flag `@(word)`\n@(line)");
      };
    };
    let context: Context = {
      path = path,
      flags = flags,
      words = rest,
    };
    let handler: fn(Context) -> int = current.action;
    return handler(context);
  };

};
