# std/fs/fs.kiru
#
# File helpers written on top of the native syscall kernel.

# Append `text` to a file, creating it when it is absent.
pub fn append(path: txt, text: txt) {
  match std::syscalls::access(path) {
    true => { std::fs::write(path, "@(std::fs::read(path))@(text)"); };
    _ => { std::fs::write(path, text); };
  };
};

# Create a unique empty file in the temporary directory and return its path.
# The caller owns the file and must remove it.
pub fn temp_file() -> txt {
  return std::syscalls::mkstemp("@(std::process::temp_dir())/kiru-XXXXXX");
};

# Whether the `[...]` class starting at `p` matches `value`: the index just
# after the closing `]`, or `std::Option.none`. A leading `!` or `^` negates,
# `a-z` is a range, and `\` escapes the next byte.
fn class_end(pattern: txt, p: int, value: int) -> std::Option<int> {
  let count: int = std::text::strlen(pattern);
  let index: int = p + 1;
  let negate: bool = false;
  match index < count && (std::text::byte_at(pattern, index) == 33 || std::text::byte_at(pattern, index) == 94) {
    true => { negate = true; index = index + 1; };
    _ => {};
  };
  let matched: bool = false;
  let first: bool = true;
  for {
    match index < count { false => { break; }; true => {}; };
    let code: int = std::text::byte_at(pattern, index);
    # 93 is `]`: it closes the class unless it is the first character.
    match code == 93 && !first {
      true => { break; };
      _ => {};
    };
    first = false;
    # `\` escapes the next byte.
    let escaped: bool = code == 92 && index + 1 < count;
    let item: int = match escaped { true => std::text::byte_at(pattern, index + 1); false => code; };
    let step: int = match escaped { true => 2; false => 1; };
    # A range `a-z`.
    let is_range: bool = index + step + 1 < count
      && std::text::byte_at(pattern, index + step) == 45
      && std::text::byte_at(pattern, index + step + 1) != 93;
    match is_range {
      true => {
        let high: int = std::text::byte_at(pattern, index + step + 1);
        match item <= value && value <= high {
          true => { matched = true; };
          _ => {};
        };
        index = index + step + 2;
      };
      _ => {
        match item == value {
          true => { matched = true; };
          _ => {};
        };
        index = index + step;
      };
    };
  };
  match index < count {
    true => { index = index + 1; };
    _ => {};
  };
  let answer: bool = match negate { true => !matched; false => matched; };
  return match answer {
    true => std::Option.some(index);
    false => std::Option.none;
  };
};

# Whether the token at `p` in `pattern` matches the byte `value`: the index
# just after the token, or `std::Option.none` when it does not match.
fn token_matches(pattern: txt, p: int, value: int) -> std::Option<int> {
  let count: int = std::text::strlen(pattern);
  let code: int = std::text::byte_at(pattern, p);
  # 92 is `\`: the next byte is a literal.
  match code == 92 {
    true => {
      match p + 1 < count {
        false => { return std::Option.none; };
        _ => {};
      };
      let next: int = p + 1;
      let literal: int = std::text::byte_at(pattern, next);
      return match literal == value {
        true => std::Option.some(next + 1);
        false => std::Option.none;
      };
    };
    _ => {};
  };
  # 63 is `?`: any one byte.
  match code == 63 {
    true => { return std::Option.some(p + 1); };
    _ => {};
  };
  # 91 is `[`: a class.
  match code == 91 {
    true => { return std::fs::class_end(pattern, p, value); };
    _ => {};
  };
  return match code == value {
    true => std::Option.some(p + 1);
    false => std::Option.none;
  };
};

# Whether `name` matches the wildcard `pattern`. `*` matches any run of bytes,
# `?` one byte, `[...]` a class, and `\` escapes the next byte. Backtracking
# is iterative — a remembered `*` and the name index to resume at — so the
# matcher needs no recursion.
fn match_name(pattern: txt, name: txt) -> bool {
  let plen: int = std::text::strlen(pattern);
  let nlen: int = std::text::strlen(name);
  let p: int = 0;
  let n: int = 0;
  let star: std::Option<int> = std::Option.none;
  let mark: int = 0;
  for {
    match n < nlen { false => { break; }; true => {}; };
    # 42 is `*`: remember it and let it match a run.
    match p < plen && std::text::byte_at(pattern, p) == 42 {
      true => { star = std::Option.some(p); mark = n; p = p + 1; };
      _ => {
        let next: std::Option<int> = match p < plen {
          true => std::fs::token_matches(pattern, p, std::text::byte_at(name, n));
          false => std::Option.none;
        };
        match next {
          std::Option.some(after) => { p = after; n = n + 1; };
          std::Option.none => {
            match star {
              std::Option.some(position) => { p = position + 1; mark = mark + 1; n = mark; };
              std::Option.none => { return false; };
            };
          };
        };
      };
    };
  };
  for {
    match p < plen && std::text::byte_at(pattern, p) == 42 { false => { break; }; true => {}; };
    p = p + 1;
  };
  return p == plen;
};

# Whether `segment` holds a wildcard byte: `*`, `?`, or a class `[`.
fn has_wildcard(segment: txt) -> bool {
  let count: int = std::text::strlen(segment);
  let index: int = 0;
  for {
    match index < count { false => { break; }; true => {}; };
    let code: int = std::text::byte_at(segment, index);
    match code == 42 || code == 63 || code == 91 {
      true => { return true; };
      _ => {};
    };
    index = index + 1;
  };
  return false;
};

# Whether `path` names a directory. A trailing slash makes `access` false for
# a file and true for a directory, so the `access` native answers it.
pub fn is_dir(path: txt) -> bool {
  return std::syscalls::access("@(path)/");
};

# The path `name` under `prefix`. The relative root has no prefix, and a
# prefix already ending in `/` needs no second slash.
fn child_of(prefix: txt, name: txt) -> txt {
  match prefix {
    "" => { return name; };
    _ => {};
  };
  match std::text::ends_with(prefix, "/") {
    true => { return "@(prefix)@(name)"; };
    _ => { return "@(prefix)/@(name)"; };
  };
};

# The entry names of a directory. The relative root lists the current
# directory.
fn entries(prefix: txt) -> std::dynamic::Vec<txt> {
  match prefix {
    "" => { return std::syscalls::readdir("."); };
    _ => { return std::syscalls::readdir(prefix); };
  };
};

# `xs` with the element at `index` replaced, or `item` appended when `index`
# is the length. This is the worklist write below: a popped slot is overwritten
# and a fresh slot is appended, so the vec keeps every slot a later write may
# revisit.
fn put<T>(xs: std::dynamic::Vec<T>, index: int, item: T) -> std::dynamic::Vec<T> {
  match index < std::dynamic::len(xs) {
    true => { return std::dynamic::replace(xs, index, item); };
    _ => { return std::dynamic::push(xs, item); };
  };
};

# Expand a glob `pattern` into a vec of matching paths, sorted. `*` matches
# any run of bytes, `?` one byte, `[...]` a class, and `\` escapes the next
# byte; a `**` segment descends recursively. The pattern is split on `/`, a
# literal segment is descended directly, and a wildcard segment lists the
# directory and matches each name. This replaces the `glob` crate: pattern
# matching is kiru, not a Rust library above the syscall floor.
pub fn glob(pattern: txt) -> std::dynamic::Vec<txt> {
  let segments: std::dynamic::Vec<txt> = std::text::split(pattern, "/");
  let absolute: bool = std::text::starts_with(pattern, "/");
  # A worklist of (segment index, prefix), in two parallel vecs because a
  # worklist entry is a pair and there is no recursion. `count` is its length.
  let work_at: std::dynamic::Vec<int> = std::dynamic::Vec.new();
  let work_prefix: std::dynamic::Vec<txt> = std::dynamic::Vec.new();
  let count: int = 1;
  work_at = std::fs::put(work_at, 0, match absolute { true => 1; false => 0; });
  work_prefix = std::fs::put(work_prefix, 0, match absolute { true => "/"; false => ""; });
  let results: std::dynamic::Vec<txt> = std::dynamic::Vec.new();
  for {
    match count > 0 { false => { break; }; true => {}; };
    count = count - 1;
    let at: int = std::dynamic::at(work_at, count);
    let prefix: txt = std::dynamic::at(work_prefix, count);
    match at == std::dynamic::len(segments) {
      true => {
        # The relative root ("") is not a path; every other prefix is a match.
        match prefix {
          "" => {};
          _ => { results = std::dynamic::push(results, prefix); };
        };
      };
      _ => {
        let segment: txt = std::dynamic::at(segments, at);
        match segment == "**" {
          true => {
            # `**` matches zero segments...
            work_at = std::fs::put(work_at, count, at + 1);
            work_prefix = std::fs::put(work_prefix, count, prefix);
            count = count + 1;
            # ...or one entry and keeps matching. A file is consumed here; a
            # directory is descended into, and its own zero-match consumes it
            # (so a directory is never matched twice).
            match std::fs::is_dir(prefix) {
              true => {
                let names: std::dynamic::Vec<txt> = std::fs::entries(prefix);
                let name_index: int = 0;
                let name_count: int = std::dynamic::len(names);
                for {
                  match name_index < name_count { false => { break; }; true => {}; };
                  let name: txt = std::dynamic::at(names, name_index);
                  let child: txt = std::fs::child_of(prefix, name);
                  match std::fs::is_dir(child) {
                    true => {
                      work_at = std::fs::put(work_at, count, at);
                      work_prefix = std::fs::put(work_prefix, count, child);
                      count = count + 1;
                    };
                    _ => {
                      work_at = std::fs::put(work_at, count, at + 1);
                      work_prefix = std::fs::put(work_prefix, count, child);
                      count = count + 1;
                    };
                  };
                  name_index = name_index + 1;
                };
              };
              _ => {};
            };
          };
          _ => {
            match std::fs::has_wildcard(segment) {
              true => {
                match std::fs::is_dir(prefix) {
                  true => {
                    let names: std::dynamic::Vec<txt> = std::fs::entries(prefix);
                    let name_index: int = 0;
                    let name_count: int = std::dynamic::len(names);
                    for {
                      match name_index < name_count { false => { break; }; true => {}; };
                      let name: txt = std::dynamic::at(names, name_index);
                      match std::fs::match_name(segment, name) {
                        true => {
                          work_at = std::fs::put(work_at, count, at + 1);
                          work_prefix = std::fs::put(work_prefix, count, std::fs::child_of(prefix, name));
                          count = count + 1;
                        };
                        _ => {};
                      };
                      name_index = name_index + 1;
                    };
                  };
                  _ => {};
                };
              };
              _ => {
                let next: txt = std::fs::child_of(prefix, segment);
                match std::syscalls::access(next) {
                  true => {
                    work_at = std::fs::put(work_at, count, at + 1);
                    work_prefix = std::fs::put(work_prefix, count, next);
                    count = count + 1;
                  };
                  _ => {};
                };
              };
            };
          };
        };
      };
    };
  };
  return std::dynamic::sort(results);
};
