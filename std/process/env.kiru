# std/process/env.kiru
#
# Environment helpers written on top of the native environment kernel.

# The directory temporary files belong in: `TMPDIR` when it is set, else
# `/tmp`, matching the platform's convention. An unset variable is
# `std::Option.none`, not empty text.
pub fn temp_dir() -> txt {
  let directory: txt = match std::syscalls::getenv("TMPDIR") {
    std::Option.some(directory) => directory;
    std::Option.none => "/tmp";
  };
  return directory;
};
