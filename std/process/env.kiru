# std/env.kiru
#
# Environment helpers written on top of the native environment kernel.

mod std::env {

  use std;
  use std::text;

  # The directory temporary files belong in: `TMPDIR` when it is set, else
  # `/tmp`, matching the platform's convention. An unset variable is the
  # absence, not empty text.
  pub fn temp_dir() -> txt {
    let directory: txt = match var("TMPDIR") {
      Option.some(directory) => directory;
      Option.none => "/tmp";
    };
    return directory;
  };

};