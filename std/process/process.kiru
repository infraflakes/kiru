# std/process.kiru
#
# The command abstraction. `std::process::command(line)` returns a `Command`
# builder and each setting method returns a new `Command`, so calls chain. The
# kernel calls are the natives in `std::syscalls`; the text forms beside them
# (`wait_for`, `signal`, and the signal-name table) are the language's.
#
# A `rec` plus chained methods is how a command is configured; a
# `std::dynamic::Map<K, V>` is how data is passed and returned. There is one
# way to run a process — the builder — and one method that changes I/O:
# `stream`. The functions in the `impl Command` block below are filed under
# `Command`: those with a `Command` first parameter are methods, and `command`
# builds the value.
#
# This file writes full paths: it uses no `use`, and every bound function is
# reached through its absolute path.

# Wait for the process `pid` and return its exit code. A raw `wait` status
# encodes the signal in its low seven bits and the exit code in its high byte,
# so a signal ended the process when that low field is non-zero, and its code
# is `128 + signal`. The syscall reports the status; what it means is the
# language's rule. It takes an int and belongs to no type, so it is a plain
# function.
pub fn wait_for(pid: int) -> int {
  let raw: int = std::syscalls::waitpid(pid);
  let signal: int = raw % 128;
  match signal {
    0 => { return raw / 256; };
    _ => { return 128 + signal; };
  };
};

# Send a named signal to the process group led by `pid`. The numbers are the
# Linux ABI values, the only platform the runtime targets; the syscall takes
# the number, the name is the convenience.
pub fn signal(pid: int, name: txt) {
  let number: int = 0;
  match name {
    "TERM" => { number = 15; };
    "KILL" => { number = 9; };
    "INT" => { number = 2; };
    "HUP" => { number = 1; };
    "QUIT" => { number = 3; };
    "USR1" => { number = 10; };
    "USR2" => { number = 12; };
    "STOP" => { number = 19; };
    "CONT" => { number = 18; };
    _ => { std::eprint("unknown signal `@(name)`"); };
  };
  std::syscalls::killpg(pid, number);
};

# Quote text as one POSIX shell word: wrap it in single quotes and replace an
# embedded quote with the `'\''` sequence, so the shell reads exactly the text
# and nothing else. It takes a text and belongs to no type, so it is a plain
# function.
pub fn quote(text: txt) -> txt {
  return "'@(std::text::replace(text, "'", "'\\''"))'";
};

# What a captured run produced: its exit code and its two output streams.
pub rec Output {
  pub code: int,
  pub out: txt,
  pub err: txt,
};

# A command under construction. `std::process::command(line)` returns the
# defaults and each setting method returns a new `Command`, so calls chain:
# `std::process::stream(std::process::dir(std::process::command("cargo build"), "docs"), "stderr", "/dev/null")`.
# An unset entry is the absence, not empty text. The type is `pub`, so a
# program can name a half-built command and configure it conditionally; the
# fields stay private, so a program builds a command through the methods.
pub rec Command {
  line: txt,
  dir: std::Option<txt>,
  env: std::Option<txt>,
  timeout: std::Option<int>,
  stdin: std::Option<txt>,
  stdout: std::Option<txt>,
  stderr: std::Option<txt>,
};

# Build the shell line for `dir`, `env`, and `timeout`, attach the streams,
# run it, and return its exit code. An absent `dir`/`env`/`timeout` is the
# default; an absent stream is inherited, so a command that changes nothing
# streams normally. An absent stream attaches nothing; a path attaches the
# stream to that file with the shell's redirection operator.
fn shell(dir: std::Option<txt>, env: std::Option<txt>, timeout: std::Option<int>, stdin: std::Option<txt>, stdout: std::Option<txt>, stderr: std::Option<txt>, line: txt) -> int {
  let directed: txt = match dir {
    std::Option.some(path) => "cd @(std::process::quote(path)) && @(line)";
    std::Option.none => line;
  };
  let exported: txt = match env {
    std::Option.some(assignments) => "export @(assignments); @(directed)";
    std::Option.none => directed;
  };
  let timed: txt = match timeout {
    std::Option.some(seconds) => "timeout @(seconds) sh -c @(std::process::quote(exported))";
    std::Option.none => exported;
  };
  let input: txt = match stdin {
    std::Option.some(path) => " < @(std::process::quote(path))";
    std::Option.none => "";
  };
  let output_redirect: txt = match stdout {
    std::Option.some(path) => " > @(std::process::quote(path))";
    std::Option.none => "";
  };
  let error: txt = match stderr {
    std::Option.some(path) => " 2> @(std::process::quote(path))";
    std::Option.none => "";
  };
  let redirects: txt = "@(input)@(output_redirect)@(error)";
  let wrapped: txt = match redirects {
    "" => timed;
    _ => "{ @(timed); }@(redirects)";
  };
  let argv: std::dynamic::Vec<txt> = std::dynamic::Vec.new();
  argv = std::dynamic::push(argv, "/bin/sh");
  argv = std::dynamic::push(argv, "-c");
  argv = std::dynamic::push(argv, wrapped);
  return std::process::wait_for(std::syscalls::posix_spawn(argv));
};

# Start a command under construction.
pub fn command(line: txt) -> std::process::Command {
  return {
    line = line,
    dir = std::Option.none,
    env = std::Option.none,
    timeout = std::Option.none,
    stdin = std::Option.none,
    stdout = std::Option.none,
    stderr = std::Option.none,
  };
};

impl Command {
  # Change the working directory.
  pub fn dir(self: std::process::Command, path: txt) -> std::process::Command {
    let copy: std::process::Command = self;
    copy.dir = std::Option.some(path);
    return copy;
  };

  # Export `name` as `value` for the command.
  pub fn env(self: std::process::Command, name: txt, value: txt) -> std::process::Command {
    let copy: std::process::Command = self;
    let assignment: txt = "@(name)=@(std::process::quote(value))";
    copy.env = match copy.env {
      std::Option.some(existing) => std::Option.some("@(existing) @(assignment)");
      std::Option.none => std::Option.some(assignment);
    };
    return copy;
  };

  # Bound the run to `seconds` with `timeout`.
  pub fn timeout(self: std::process::Command, seconds: int) -> std::process::Command {
    let copy: std::process::Command = self;
    copy.timeout = std::Option.some(seconds);
    return copy;
  };

  # Send one stream to `target`: `stream` is "stdin", "stdout", or "stderr" and
  # `target` is the path the stream is attached to (`/dev/null` discards it).
  # Not calling `stream` streams normally: the child inherits the stream.
  pub fn stream(self: std::process::Command, stream: txt, target: txt) -> std::process::Command {
    let copy: std::process::Command = self;
    match stream {
      "stdin" => { copy.stdin = std::Option.some(target); };
      "stdout" => { copy.stdout = std::Option.some(target); };
      "stderr" => { copy.stderr = std::Option.some(target); };
      _ => { std::eprint("command: `@(stream)` is not a stream; use stdin, stdout, or stderr"); };
    };
    return copy;
  };

  # Run the command and return its exit code.
  pub fn run(self: std::process::Command) -> int {
    return std::process::shell(self.dir, self.env, self.timeout, self.stdin, self.stdout, self.stderr, self.line);
  };

  # Run the command and return its exit code and captured streams. The line's
  # stdout and stderr go to temporary files, which are read once the command
  # exits and then removed, so the output never streams.
  pub fn capture(self: std::process::Command) -> std::process::Output {
    let out_path: txt = std::fs::temp_file();
    let err_path: txt = std::fs::temp_file();
    let code: int = std::process::shell(self.dir, self.env, self.timeout, self.stdin, std::Option.some(out_path), std::Option.some(err_path), self.line);
    let result: std::process::Output = {
      code = code,
      out = std::fs::read(out_path),
      err = std::fs::read(err_path),
    };
    std::syscalls::unlink(out_path);
    std::syscalls::unlink(err_path);
    return result;
  };
};
