# std/dynamic/vec.kiru
#
# The vec: an ordered list. `Vec<T>` is the runtime's list type; the compiler
# registers its declaration in this namespace, and the runtime provides its
# five operations (`new`, `len`, `at`, `replace`, `push`) as natives, listed in
# `natives.md`. A function whose first parameter is a `Vec<T>` is callable as
# `xs.name(...)`, so every function here is a vec method written in kiru on top
# of those five. `std::join` (a text-vec convenience) stays in `std.kiru`,
# because it applies to `Vec<txt>` alone rather than to every `Vec<T>`.

# `bool`/`int` live at the `std` root and `txt` in its own category. `Vec<T>`
# is declared in this namespace, so it needs no `use` here.
use std;
use std::Option;

# A new vec with `item` inserted at the front.
pub fn with_first<T>(self: Vec<T>, item: T) -> Vec<T> {
  let out: Vec<T> = Vec.new();
  out = out.push(item);
  let index: int = 0;
  let count: int = self.len();
  for {
    match index < count { false => { break; }; true => {}; };
    out = out.push(self.at(index));
    index = index + 1;
  };
  return out;
};

# A new vec with every element of `other` after every element of `self`.
pub fn concat<T>(self: Vec<T>, other: Vec<T>) -> Vec<T> {
  let result: Vec<T> = self;
  let index: int = 0;
  let count: int = other.len();
  for {
    match index < count { false => { break; }; true => {}; };
    result = result.push(other.at(index));
    index = index + 1;
  };
  return result;
};

# A new vec with the elements reversed. It appends into a fresh vec while
# reading `self` from the end.
pub fn reversed<T>(self: Vec<T>) -> Vec<T> {
  let result: Vec<T> = Vec.new();
  let index: int = self.len();
  for {
    match index > 0 { false => { break; }; true => {}; };
    index = index - 1;
    result = result.push(self.at(index));
  };
  return result;
};

# Whether `item` is an element.
pub fn contains<T>(self: Vec<T>, item: T) -> bool {
  let found: bool = false;
  let index: int = 0;
  let count: int = self.len();
  for {
    match index < count { false => { break; }; true => {}; };
    match self.at(index) == item {
      true => { found = true; break; };
      _ => {};
    };
    index = index + 1;
  };
  return found;
};

# The first index of `item`, or the declared absence when it is not an
# element. Equality is `==`.
pub fn find<T>(self: Vec<T>, item: T) -> Option<int> {
  let index: int = 0;
  let count: int = self.len();
  for {
    match index < count { false => { break; }; true => {}; };
    match self.at(index) == item {
      true => { return Option.some(index); };
      _ => {};
    };
    index = index + 1;
  };
  return Option.none;
};

# A new vec with adjacent duplicates dropped. `sorted_by` then `uniqued` keeps
# one of each value, so a sorted vec becomes unique. Equality is `==`.
pub fn uniqued<T>(self: Vec<T>) -> Vec<T> {
  let out: Vec<T> = Vec.new();
  let count: int = self.len();
  match count {
    0 => { return out; };
    _ => {};
  };
  out = out.push(self.at(0));
  let index: int = 1;
  for {
    match index < count { false => { break; }; true => {}; };
    match self.at(index) == self.at(index - 1) {
      true => {};
      _ => { out = out.push(self.at(index)); };
    };
    index = index + 1;
  };
  return out;
};

# A new vec with `apply` called on every element.
pub fn map<T, U>(self: Vec<T>, apply: fn(T) -> U) -> Vec<U> {
  let out: Vec<U> = Vec.new();
  let index: int = 0;
  let count: int = self.len();
  for {
    match index < count { false => { break; }; true => {}; };
    out = out.push(apply(self.at(index)));
    index = index + 1;
  };
  return out;
};

# A new vec with the elements for which `keep` answers `true`.
pub fn filter<T>(self: Vec<T>, keep: fn(T) -> bool) -> Vec<T> {
  let out: Vec<T> = Vec.new();
  let index: int = 0;
  let count: int = self.len();
  for {
    match index < count { false => { break; }; true => {}; };
    let item: T = self.at(index);
    match keep(item) {
      true => { out = out.push(item); };
      _ => {};
    };
    index = index + 1;
  };
  return out;
};

# The first element. An empty vec has no first element, so it stops the run.
pub fn first<T>(self: Vec<T>) -> T {
  match self.len() {
    0 => { std::eprint("first: the vec is empty"); };
    _ => {};
  };
  return self.at(0);
};

# The last element. An empty vec has no last element, so it stops the run.
pub fn last<T>(self: Vec<T>) -> T {
  match self.len() {
    0 => { std::eprint("last: the vec is empty"); };
    _ => {};
  };
  return self.at(self.len() - 1);
};

# A new vec ordered by `less`: an iterative bottom-up merge sort. Each pass
# merges runs of `width` (starting at one) into `merged`, then doubles
# `width`, until one run covers the vec.
pub fn sorted_by<T>(self: Vec<T>, less: fn(T, T) -> bool) -> Vec<T> {
  let source: Vec<T> = self;
  let count: int = source.len();
  match count < 2 {
    true => { return source; };
    _ => {};
  };
  let width: int = 1;
  for {
    match width < count { false => { break; }; true => {}; };
    let merged: Vec<T> = Vec.new();
    let base: int = 0;
    for {
      match base < count { false => { break; }; true => {}; };
      let middle: int = match base + width < count {
        true => base + width; false => count;
      };
      let end: int = match base + width + width < count {
        true => base + width + width; false => count;
      };
      let left: int = base;
      let right: int = middle;
      for {
        match left < middle && right < end { false => { break; }; true => {}; };
        match less(source.at(right), source.at(left)) {
          true => { merged = merged.push(source.at(right)); right = right + 1; };
          false => { merged = merged.push(source.at(left)); left = left + 1; };
        };
      };
      for {
        match left < middle { false => { break; }; true => {}; };
        merged = merged.push(source.at(left));
        left = left + 1;
      };
      for {
        match right < end { false => { break; }; true => {}; };
        merged = merged.push(source.at(right));
        right = right + 1;
      };
      base = end;
    };
    source = merged;
    width = width + width;
  };
  return source;
};

# Whether `a` orders before `b`; the ordering the text `sorted` uses.
pub fn text_less(a: txt, b: txt) -> bool {
  return a < b;
};

# A new vec of text in byte-lexicographic order. It applies to `Vec<txt>`
# alone; a generic function cannot constrain its elements to text.
pub fn sorted(items: Vec<txt>) -> Vec<txt> {
  return items.sorted_by(text_less);
};
