# steps.kiru
#
# Reusable steps for the repository pipeline. A step is one command run in a
# directory; it either succeeds or stops the run.

module steps;

# Run a command in a project directory, streaming its output. A nonzero code
# fails the run with the project and command named.
fn run_in(rec project, txt line) {
  txt code = std::command({ Dir = project.dir, Direnv = project.direnv, Mode = "exit code" }, line);
  switch(code) {
    case("0") {};
    default { std::eprint(project.name + ": " + line); };
  };
};

# Run a command in the current directory, streaming its output.
fn run(txt line) {
  switch(std::command({ Mode = "exit code" }, line)) {
    case("0") {};
    default { std::eprint(line); };
  };
};

# Run a command in a project directory and return its code, streaming it.
fn code_in(rec project, txt line) {
  return std::command({ Dir = project.dir, Direnv = project.direnv, Mode = "exit code" }, line);
};

# Run a command and return its trimmed stdout.
fn capture(txt line) {
  return std::command({ Mode = "stdout" }, line);
};
